# config/application.yml.heroku - Heroku用設定テンプレート
# 実際の認証情報はコミットせず、Heroku Config Varsへ直接設定してください。

gmail_username: "<GMAIL_USERNAME>"
gmail_app_password: "<GMAIL_APP_PASSWORD>"
line_channel_secret: "<LINE_CHANNEL_SECRET>"
line_channel_token: "<LINE_CHANNEL_TOKEN>"
admin_email: "<ADMIN_EMAIL>"
mail_from: "<MAIL_FROM>"
app_host: "https://your-heroku-app-name.herokuapp.com"

# DATABASE_URLとREDIS_URLはHerokuで設定される
secret_key_base: "<SECRET_KEY_BASE>"
log_level: "info"
time_zone: "Tokyo"
rails_serve_static_files: true
rails_12factor: true
