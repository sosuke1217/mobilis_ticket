<div class="container-lg my-5">
  <!-- 📊 使用状況セクション -->
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="card-title mb-4">
        <i class="fas fa-chart-bar me-2"></i>月ごとのテンプレート別使用数
      </h2>
      <%= form_with url: admin_root_path, method: :get, local: true, id: "month-select-form" do %>
        <div class="row g-3 align-items-end mb-4">
          <div class="col-auto">
            <%= label_tag :year, "年を選択", class: "form-label" %>
            <%= select_tag :year,
                  options_for_select(@available_years.map { |y| [y.strftime("%Y年"), y.strftime("%Y")] }, @selected_year.to_s),
                  class: "form-select",
                  id: "year-select",
                  onchange: "updateMonthOptions();" %>
          </div>
          <div class="col-auto">
            <%= label_tag :month, "月を選択", class: "form-label" %>
            <%= select_tag :month,
                  options_for_select(@available_months.map { |m| [m.strftime("%m月"), m.strftime("%m")] }, @selected_month.to_s.rjust(2, '0')),
                  class: "form-select",
                  id: "month-select" %>
          </div>
          <div class="col-auto">
            <%= submit_tag "表示", class: "btn btn-primary", id: "submit-btn" %>
          </div>
        </div>
        <div class="row mb-3">
          <div class="col-12">
            <small class="text-muted">
              <i class="fas fa-info-circle me-1"></i>
              年または月を変更した場合は「表示」ボタンを押してください。
            </small>
          </div>
        </div>
      <% end %>

      <div class="row mb-4">
        <div class="col-md-6">
          <div class="alert alert-secondary d-flex align-items-center">
            <i class="fas fa-file-invoice-dollar me-2"></i>
            <strong class="me-2">売上合計（チケット発行）:</strong>
            <span class="fs-5"><%= number_to_currency(@total_sales_amount, unit: "¥", precision: 0) %></span>
          </div>
        </div>
        <div class="col-md-6">
          <div class="alert alert-info d-flex align-items-center">
            <i class="fas fa-check-circle me-2"></i>
            <strong class="me-2">消化合計（チケット使用）:</strong>
            <span class="fs-5"><%= number_to_currency(@total_sales, unit: "¥", precision: 0) %></span>
          </div>
        </div>
      </div>

      <% if @template_usage_stats.present? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover table-bordered">
            <thead>
              <tr>
                <th>テンプレート名</th>
                <th>使用回数</th>
                <th>消化金額</th>
              </tr>
            </thead>
            <tbody>
              <% @template_usage_stats.each do |template_name, count| %>
                <% unit_price = @template_prices[template_name].to_i %>
                <% subtotal = unit_price * count %>
                <tr>
                  <td><%= template_name %></td>
                  <td><%= count %></td>
                  <td><%= number_to_currency(subtotal, unit: "¥", precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="table-secondary fw-bold">
                <td>合計</td>
                <td><%= @total_usage_count %></td>
                <td><%= number_to_currency(@total_sales, unit: "¥", precision: 0) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% else %>
        <p class="text-muted">この月にはデータがありません。</p>
      <% end %>
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 初期設定
  updateMonthOptions();
  
  // 年選択が変更されたときの処理
  const yearSelect = document.getElementById('year-select');
  if (yearSelect) {
    yearSelect.addEventListener('change', function() {
      updateMonthOptions();
      highlightSubmitButton('年変更後');
    });
  }
  
  // 月選択が変更されたときの処理
  const monthSelect = document.getElementById('month-select');
  if (monthSelect) {
    monthSelect.addEventListener('change', function() {
      highlightSubmitButton('月変更後');
    });
  }
});

// 月のオプションを更新
function updateMonthOptions() {
  const yearSelect = document.getElementById('year-select');
  const monthSelect = document.getElementById('month-select');
  
  if (!yearSelect || !monthSelect) return;
  
  const selectedYear = yearSelect.value;
  const currentYear = new Date().getFullYear().toString();
  const currentMonth = (new Date().getMonth() + 1).toString().padStart(2, '0');
  
  // 月のオプションをクリア
  monthSelect.innerHTML = '';
  
  // 選択された年が現在の年の場合、現在の月までしか選択できない
  const maxMonth = (selectedYear === currentYear) ? parseInt(currentMonth) : 12;
  
  for (let month = 1; month <= maxMonth; month++) {
    const option = document.createElement('option');
    option.value = month.toString().padStart(2, '0');
    option.textContent = month + '月';
    
    // 現在の年月が選択されている場合は選択状態にする
    if (selectedYear === currentYear && month.toString().padStart(2, '0') === currentMonth) {
      option.selected = true;
    }
    
    monthSelect.appendChild(option);
  }
  
  // 年が変更された場合は、適切な月を選択するだけ
  // フォームは自動送信しない
  if (selectedYear === currentYear) {
    monthSelect.value = currentMonth;
  } else {
    monthSelect.value = '01'; // 過去の年は1月を選択
  }
}

// 送信ボタンを強調表示
function highlightSubmitButton(type) {
  const submitBtn = document.getElementById('submit-btn');
  if (submitBtn) {
    submitBtn.classList.add('btn-warning');
    submitBtn.classList.remove('btn-primary');
    submitBtn.textContent = `表示（${type}）`;
    
    // フォーム送信後にボタンを元の状態に戻す
    const form = document.getElementById('month-select-form');
    if (form) {
      form.addEventListener('submit', function() {
        setTimeout(function() {
          submitBtn.classList.remove('btn-warning');
          submitBtn.classList.add('btn-primary');
          submitBtn.textContent = '表示';
        }, 100);
      }, { once: true });
    }
  }
}
</script>
