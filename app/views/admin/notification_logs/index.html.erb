<div class="container-lg my-4">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h2 mb-1">
            <i class="fas fa-bell text-primary me-2"></i>通知履歴一覧
          </h1>
          <p class="text-muted mb-0">送信された通知の履歴を確認できます</p>
        </div>
        <div class="d-flex align-items-center">
          <span class="badge bg-primary fs-6 me-3">
            <i class="fas fa-list me-1"></i><%= @notification_logs.total_count %>件
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 検索・フィルターセクション -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="card-title mb-3">
        <i class="fas fa-search text-secondary me-2"></i>検索・フィルター
      </h5>
      <%= search_form_for @q, url: admin_notification_logs_path, method: :get, html: { class: "row g-3" } do |f| %>
        <div class="col-md-4">
          <%= f.label :user_name_cont, "ユーザー名", class: "form-label fw-bold" %>
          <%= f.text_field :user_name_cont, class: "form-control", placeholder: "例: 吉田壮祐" %>
        </div>
        <div class="col-md-3">
          <%= f.label :kind_eq, "通知種別", class: "form-label fw-bold" %>
          <%= f.select :kind_eq, 
                options_for_select([
                  ['期限通知', 'expiry_reminder'],
                  ['予約リクエスト', 'booking_request'],
                  ['予約確定', 'booking_confirmed'],
                  ['予約キャンセル', 'booking_cancelled']
                ], params.dig(:q, :kind_eq)), 
                { include_blank: "全ての種別" }, 
                { class: "form-select" } %>
        </div>
        <div class="col-md-3">
          <%= f.label :sent_at_gteq, "送信日（開始）", class: "form-label fw-bold" %>
          <%= f.date_field :sent_at_gteq, class: "form-control" %>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <div class="d-grid gap-2 w-100">
            <%= f.submit "検索", class: "btn btn-primary" %>
            <%= link_to "リセット", admin_notification_logs_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 通知履歴テーブル -->
  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <h5 class="card-title mb-0">
        <i class="fas fa-table text-secondary me-2"></i>通知履歴
      </h5>
    </div>
    <div class="card-body p-0">
      <% if @notification_logs.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th class="border-0">
                  <%= sort_link(@q, :sent_at, "送信日時", { class: "text-decoration-none text-dark" }) %>
                  <i class="fas fa-sort ms-1"></i>
                </th>
                <th class="border-0">
                  <%= sort_link(@q, 'user.name', "ユーザー", { class: "text-decoration-none text-dark" }) %>
                  <i class="fas fa-sort ms-1"></i>
                </th>
                <th class="border-0">
                  <%= sort_link(@q, 'ticket.title', "チケット名", { class: "text-decoration-none text-dark" }) %>
                  <i class="fas fa-sort ms-1"></i>
                </th>
                <th class="border-0">
                  <%= sort_link(@q, :kind, "種別", { class: "text-decoration-none text-dark" }) %>
                  <i class="fas fa-sort ms-1"></i>
                </th>
                <th class="border-0">メッセージ</th>
                <th class="border-0 text-center">操作</th>
              </tr>
            </thead>
            <tbody>
              <% @notification_logs.each do |log| %>
                <tr class="border-bottom">
                  <td class="align-middle">
                    <div class="d-flex flex-column">
                      <span class="fw-bold"><%= l(log.sent_at, format: :date) %></span>
                      <small class="text-muted"><%= l(log.sent_at, format: :time) %></small>
                    </div>
                  </td>
                  <td class="align-middle">
                    <% if log.user.present? %>
                      <%= link_to(log.user.name.presence || log.user.line_user_id || "不明", 
                            admin_user_path(log.user), 
                            class: "text-decoration-none fw-bold text-primary") %>
                      <% if log.user.line_user_id.present? %>
                        <i class="fab fa-line text-success ms-1" title="LINE連携"></i>
                      <% end %>
                    <% else %>
                      <span class="text-muted">削除済み</span>
                    <% end %>
                  </td>
                  <td class="align-middle">
                    <% if log.ticket.present? %>
                      <span class="badge bg-info text-white">
                        <%= log.ticket.title || "不明" %>
                      </span>
                    <% else %>
                      <span class="text-muted">削除済み</span>
                    <% end %>
                  </td>
                  <td class="align-middle">
                    <% case log.kind %>
                    <% when 'expiry_reminder' %>
                      <span class="badge bg-warning text-dark">
                        <i class="fas fa-clock me-1"></i>期限通知
                      </span>
                    <% when 'booking_request' %>
                      <span class="badge bg-primary">
                        <i class="fas fa-calendar-plus me-1"></i>予約リクエスト
                      </span>
                    <% when 'booking_confirmed' %>
                      <span class="badge bg-success">
                        <i class="fas fa-check me-1"></i>予約確定
                      </span>
                    <% when 'booking_cancelled' %>
                      <span class="badge bg-danger">
                        <i class="fas fa-times me-1"></i>予約キャンセル
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">
                        <i class="fas fa-bell me-1"></i><%= log.kind %>
                      </span>
                    <% end %>
                  </td>
                  <td class="align-middle">
                    <div class="text-truncate" style="max-width: 200px;" title="<%= log.message %>">
                      <%= log.message %>
                    </div>
                  </td>
                  <td class="align-middle text-center">
                    <%= button_to admin_notification_log_path(log),
                          method: :delete,
                          data: { 
                            confirm: "この通知ログを削除してもよろしいですか？",
                            turbo_confirm: "この通知ログを削除してもよろしいですか？"
                          },
                          class: "btn btn-sm btn-outline-danger",
                          form: { class: "d-inline" } do %>
                      <i class="fas fa-trash me-1"></i>削除
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fas fa-bell-slash text-muted" style="font-size: 3rem;"></i>
          <h5 class="text-muted mt-3">通知履歴はまだありません</h5>
          <p class="text-muted">通知が送信されると、ここに履歴が表示されます。</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- ページネーション -->
  <% if @notification_logs.any? %>
    <div class="d-flex justify-content-center mt-4">
      <%= paginate @notification_logs, theme: 'bootstrap5' %>
    </div>
  <% end %>
</div>

<style>
/* カスタムスタイル */
.table th {
  font-weight: 600;
  color: #495057;
}

.table td {
  vertical-align: middle;
}

.badge {
  font-size: 0.75rem;
}

.text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ホバー効果 */
.table-hover tbody tr:hover {
  background-color: rgba(0, 123, 255, 0.05);
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .badge {
    font-size: 0.7rem;
  }
}
</style>
