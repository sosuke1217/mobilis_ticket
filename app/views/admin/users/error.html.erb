<div class="container-lg my-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i>エラーが発生しました
          </h5>
        </div>
        <div class="card-body text-center">
          <div class="mb-4">
            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
            <h4 class="text-danger">ユーザー一覧の表示中にエラーが発生しました</h4>
            <% if flash[:error] %>
              <p class="text-muted"><%= flash[:error] %></p>
            <% end %>
          </div>
          
          <div class="d-flex justify-content-center gap-3">
            <%= link_to admin_users_path, class: "btn btn-primary" do %>
              <i class="fas fa-refresh me-1"></i>再読み込み
            <% end %>
            <%= link_to admin_dashboard_path, class: "btn btn-outline-secondary" do %>
              <i class="fas fa-home me-1"></i>ダッシュボードに戻る
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
