            <i class="fas fa-info-circle me-1"></i>
            この操作は取り消すことができません
          </p>
        </div>
      </div>
      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-secondary">
          <i class="fas fa-times me-1"></i>キャンセル
        </button>
        <button type="button" class="btn btn-danger" id="confirmDeleteTicketBtn" data-ticket-management-target="confirmButton">
          <i class="fas fa-trash me-1"></i>削除する
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// 統計を更新する関数（Stimulusコントローラーで処理されるため削除）

// チケット作成フォームの送信処理はStimulusコントローラーで処理されるため削除

// チケット使用ボタンのイベントリスナーはStimulusコントローラーで処理されるため削除

// モーダル表示関数
function showDeleteTicketModal(ticketId, ticketName) {
  console.log('🔍 Showing delete ticket modal for ticket:', ticketId);
  
  const modalElement = document.getElementById('deleteTicketModal');
  if (!modalElement) {
    console.error('❌ Delete ticket modal not found');
    return;
  }
  
  // BootstrapのモーダルAPIを使用
  const modal = new bootstrap.Modal(modalElement);
  modal.show();
  
  console.log('✅ Delete ticket modal shown');
}

// グローバル関数として定義（Stimulusコントローラーと連携）
function hideDeleteTicketModal() {
  console.log('🔍 Hiding delete ticket modal via global function');
  
  const modalElement = document.getElementById('deleteTicketModal');
  if (!modalElement) {
    console.error('❌ Delete ticket modal not found');
    return;
  }
  
  // Stimulusコントローラーが存在する場合は、そのメソッドを呼ぶ
  const controller = document.querySelector('[data-controller*="ticket-management"]');
  if (controller) {
    try {
      // Stimulusコントローラーのインスタンスを取得
      const stimulusApp = window.Stimulus || window.Application;
      if (stimulusApp) {
        const controllerInstance = stimulusApp.getControllerForElementAndIdentifier(controller, 'ticket-management');
        if (controllerInstance && controllerInstance.hideDeleteTicketModal) {
          console.log('✅ Calling Stimulus controller hideDeleteTicketModal method');
          controllerInstance.hideDeleteTicketModal();
          return; // Stimulusコントローラーのメソッドが実行されたので終了
        }
      }
      
      // 直接プロパティアクセスも試す
      if (controller.stimulusController && controller.stimulusController.hideDeleteTicketModal) {
        console.log('✅ Calling Stimulus controller hideDeleteTicketModal method via direct access');
        controller.stimulusController.hideDeleteTicketModal();
        return; // Stimulusコントローラーのメソッドが実行されたので終了
      }
      
      // フォールバック: 直接isProcessingをリセット
      if (controller.stimulusController) {
        controller.stimulusController.isProcessing = false;
        console.log('✅ Stimulus controller isProcessing reset via direct access');
      }
    } catch (error) {
      console.log('⚠️ Stimulus controller manipulation failed:', error);
    }
  }
  
  // 複数の方法でモーダルを閉じる
  try {
    // 方法1: BootstrapのモーダルAPIを使用
    const modal = bootstrap.Modal.getInstance(modalElement);
    if (modal) {
      modal.hide();
      console.log('✅ Delete ticket modal hidden using Bootstrap API');
    } else {
      // 方法2: 新しいBootstrapモーダルインスタンスを作成して閉じる
      const newModal = new bootstrap.Modal(modalElement);
      newModal.hide();
      console.log('✅ Delete ticket modal hidden using new Bootstrap instance');
    }
  } catch (error) {
    console.log('⚠️ Bootstrap API failed, using manual method:', error);
  }
  
  // 方法3: 確実に手動で非表示（フォールバック）
  setTimeout(() => {
    // モーダル要素を完全にリセット
    modalElement.style.display = 'none';
    modalElement.style.position = '';
    modalElement.style.top = '';
    modalElement.style.left = '';
    modalElement.style.width = '';
    modalElement.style.height = '';
    modalElement.style.zIndex = '';
    modalElement.style.backgroundColor = '';
    modalElement.classList.remove('show');
    modalElement.setAttribute('aria-hidden', 'true');
    modalElement.setAttribute('aria-modal', 'false');
    
    // bodyの状態を完全にリセット
    document.body.classList.remove('modal-open');
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';
    document.body.style.position = '';
    
    // すべての背景要素を削除
    const backdrops = document.querySelectorAll('.modal-backdrop');
    backdrops.forEach(backdrop => backdrop.remove());
    
    // 追加のクリーンアップ: すべてのモーダル関連クラスを削除
    document.querySelectorAll('.modal').forEach(modal => {
      modal.classList.remove('show');
      modal.style.display = 'none';
    });
    
    console.log('✅ Delete ticket modal hidden manually (fallback)');
    
    // 最終確認: 1秒後にモーダルがまだ表示されている場合は強制削除
    setTimeout(() => {
      if (modalElement.style.display !== 'none' || modalElement.offsetParent !== null) {
        console.log('🚨 Modal still visible, forcing removal');
        modalElement.remove();
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        console.log('🚨 Modal forcibly removed');
      }
    }, 1000);
  }, 100);
}

// モーダル初期化関数
function initializeDeleteTicketModal() {
  console.log('🔍 Initializing delete ticket modal');
  
  const modalElement = document.getElementById('deleteTicketModal');
  if (!modalElement) {
    console.error('❌ Delete ticket modal not found');
    return;
  }
  
  // 削除ボタンのイベントリスナーを追加
  const deleteButton = modalElement.querySelector('.btn-danger');
  if (deleteButton) {
    deleteButton.removeEventListener('click', handleDeleteConfirm);
    deleteButton.addEventListener('click', handleDeleteConfirm);
  }
  
  // キャンセルボタンのイベントリスナーを追加
  const cancelButton = modalElement.querySelector('.btn-secondary');
  if (cancelButton) {
    cancelButton.removeEventListener('click', handleCancel);
    cancelButton.addEventListener('click', handleCancel);
  }
  
  // 閉じるボタンのイベントリスナーを追加
  const closeButton = modalElement.querySelector('.btn-close');
  if (closeButton) {
    closeButton.removeEventListener('click', hideDeleteTicketModal);
    closeButton.addEventListener('click', hideDeleteTicketModal);
  }
  
  console.log('✅ Delete ticket modal initialization completed');
}

// 削除確認処理
function handleDeleteConfirm(e) {
  e.preventDefault();
  e.stopPropagation();
  console.log('🔍 Delete confirmed, hiding modal');
  hideDeleteTicketModal();
  // ここで実際の削除処理を実行
  // 削除処理は別途実装
}

// キャンセル処理
function handleCancel(e) {
  e.preventDefault();
  e.stopPropagation();
  console.log('🔍 Cancel clicked, hiding modal');
  hideDeleteTicketModal();
}

// ============================================
// 有効期限延長モーダル関連の関数
// ============================================

// モーダルを強制的に表示する（フォールバック用）
function forceShowModal(modalElement) {
  modalElement.style.display = 'block';
  modalElement.classList.add('show');
  modalElement.setAttribute('aria-hidden', 'false');
  modalElement.style.zIndex = '1055';
  document.body.classList.add('modal-open');
  
  // バックドロップを確認・追加
  let backdrop = document.querySelector('.modal-backdrop');
  if (!backdrop) {
    backdrop = document.createElement('div');
    backdrop.className = 'modal-backdrop fade show';
    backdrop.style.zIndex = '1050';
    document.body.appendChild(backdrop);
  }
}

// モーダルを強制的に非表示にする（フォールバック用）
function forceHideModal(modalElement) {
  modalElement.classList.remove('show');
  modalElement.style.display = '';
  modalElement.style.zIndex = '';
  modalElement.style.position = '';
  modalElement.style.top = '';
  modalElement.style.left = '';
  modalElement.style.width = '';
  modalElement.style.height = '';
  modalElement.setAttribute('aria-hidden', 'true');
  document.body.classList.remove('modal-open');
  document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
}

// 有効期限延長モーダルの表示
window.showExtendExpiryModal = function(ticketId, ticketName, currentExpiry, currentExpiryDisplay) {
  const modalElement = document.getElementById('extendExpiryModal');
  if (!modalElement) return;
  
  // モーダル要素の取得
  const ticketIdInput = document.getElementById('extendTicketId');
  const ticketNameElement = document.getElementById('extendTicketName');
  const currentExpiryElement = document.getElementById('currentExpiryDate');
  const extendDaysInput = document.getElementById('extendDays');
  
  if (!ticketIdInput || !ticketNameElement || !currentExpiryElement || !extendDaysInput) return;
  
  // データを設定
  ticketIdInput.value = ticketId;
  ticketNameElement.textContent = ticketName;
  currentExpiryElement.textContent = currentExpiryDisplay || currentExpiry;
  extendDaysInput.value = 30;
  
  // 日付入力フィールドの最小値を設定
  const newExpiryDateInput = document.getElementById('newExpiryDate');
  if (newExpiryDateInput && currentExpiry) {
    try {
      const currentDate = new Date(currentExpiry);
      currentDate.setDate(currentDate.getDate() + 1);
      newExpiryDateInput.setAttribute('min', currentDate.toISOString().split('T')[0]);
    } catch (e) {
      // エラーは無視
    }
  }
  
  // 延長方法を「日数で延長」にリセット
  const extendByDaysRadio = document.getElementById('extendByDays');
  if (extendByDaysRadio) {
    extendByDaysRadio.checked = true;
    const extendByDaysSection = document.getElementById('extendByDaysSection');
    const extendByDateSection = document.getElementById('extendByDateSection');
    if (extendByDaysSection) extendByDaysSection.style.display = 'block';
    if (extendByDateSection) extendByDateSection.style.display = 'none';
  }
  
  updateExpiryPreview();
  
  // BootstrapのモーダルAPIを使用
  try {
    let modal = bootstrap.Modal.getInstance(modalElement);
    if (!modal) {
      modal = new bootstrap.Modal(modalElement, {
        backdrop: true,
        keyboard: true,
        focus: true
      });
    }
    modal.show();
    
    // 表示確認（フォールバック）
    setTimeout(() => {
      if (!modalElement.classList.contains('show')) {
        forceShowModal(modalElement);
      }
    }, 100);
  } catch (e) {
    forceShowModal(modalElement);
  }
};

// 有効期限延長モーダルの非表示
window.hideExtendExpiryModal = function() {
  const modalElement = document.getElementById('extendExpiryModal');
  if (!modalElement) return;
  
  try {
    const modal = bootstrap.Modal.getInstance(modalElement);
    if (modal) {
      modal.hide();
    } else {
      forceHideModal(modalElement);
    }
  } catch (e) {
    forceHideModal(modalElement);
  }
};

// 有効期限プレビューの更新
function updateExpiryPreview() {
  const currentExpiryStr = document.getElementById('currentExpiryDate')?.textContent;
  const extendDays = document.getElementById('extendDays')?.value;
  const previewElement = document.getElementById('newExpiryPreview');
  
  if (!currentExpiryStr || !extendDays || !previewElement) return;
  
  try {
    // 日本語形式の日付をパース（例: "2025年1月28日"）
    const dateMatch = currentExpiryStr.match(/(\d{4})年(\d{1,2})月(\d{1,2})日/);
    let currentExpiry;
    
    if (dateMatch) {
      currentExpiry = new Date(parseInt(dateMatch[1]), parseInt(dateMatch[2]) - 1, parseInt(dateMatch[3]));
    } else {
      currentExpiry = new Date(currentExpiryStr);
    }
    
    const newExpiry = new Date(currentExpiry);
    newExpiry.setDate(newExpiry.getDate() + parseInt(extendDays));
    
    const year = newExpiry.getFullYear();
    const month = String(newExpiry.getMonth() + 1).padStart(2, '0');
    const day = String(newExpiry.getDate()).padStart(2, '0');
    
    previewElement.textContent = `${year}年${month}月${day}日`;
  } catch (e) {
    previewElement.textContent = '計算できません';
  }
}

// ============================================
// イベントリスナーの設定
// ============================================

// 延長ボタンのクリックハンドラー
function handleExtendExpiryClick(btn) {
  const ticketId = btn.getAttribute('data-ticket-id');
  const ticketName = btn.getAttribute('data-ticket-name');
  const currentExpiry = btn.getAttribute('data-current-expiry');
  const currentExpiryDisplay = btn.getAttribute('data-current-expiry-display');
  
  if (window.showExtendExpiryModal) {
    window.showExtendExpiryModal(ticketId, ticketName, currentExpiry, currentExpiryDisplay);
  }
}

// 延長方法の切り替え
function setupExtendMethodToggle() {
  const extendByDays = document.getElementById('extendByDays');
  const extendByDate = document.getElementById('extendByDate');
  const extendByDaysSection = document.getElementById('extendByDaysSection');
  const extendByDateSection = document.getElementById('extendByDateSection');
  
  if (!extendByDays || !extendByDate) return;
  if (extendByDays.dataset.bound === 'true') return;
  extendByDays.dataset.bound = 'true';
  extendByDate.dataset.bound = 'true';
  
  extendByDays.addEventListener('change', function() {
    if (this.checked) {
      extendByDaysSection.style.display = 'block';
      extendByDateSection.style.display = 'none';
      document.getElementById('extendDays').required = true;
      document.getElementById('newExpiryDate').required = false;
      updateExpiryPreview();
    }
  });
  
  extendByDate.addEventListener('change', function() {
    if (this.checked) {
      extendByDaysSection.style.display = 'none';
      extendByDateSection.style.display = 'block';
      document.getElementById('extendDays').required = false;
      document.getElementById('newExpiryDate').required = true;
    }
  });
}

// 延長確認ボタンの送信処理
function setupExtendExpirySubmit() {
  const confirmExtendBtn = document.getElementById('confirmExtendExpiryBtn');
  if (!confirmExtendBtn || confirmExtendBtn.dataset.bound === 'true') return;
  confirmExtendBtn.dataset.bound = 'true';
  
  confirmExtendBtn.addEventListener('click', function() {
    const ticketId = document.getElementById('extendTicketId').value;
    const extendMethodRadio = document.querySelector('input[name="extendMethod"]:checked');
    
    if (!extendMethodRadio) {
      alert('延長方法を選択してください');
      return;
    }
    
    const extendMethod = extendMethodRadio.value;
    const url = `/admin/tickets/${ticketId}/extend_expiry`;
    let data = {};
    
    if (extendMethod === 'days') {
      const extendDays = document.getElementById('extendDays').value;
      if (!extendDays || extendDays <= 0) {
        alert('延長日数を入力してください');
        return;
      }
      data.extend_days = extendDays;
    } else {
      const newExpiryDate = document.getElementById('newExpiryDate').value;
      if (!newExpiryDate) {
        alert('新しい有効期限を選択してください');
        return;
      }
      data.new_expiry_date = newExpiryDate;
    }
    
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    if (!csrfToken) {
      alert('CSRFトークンが見つかりません。ページを再読み込みしてください。');
      return;
    }
    
    confirmExtendBtn.disabled = true;
    
    fetch(url, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(data)
    })
    .then(async response => {
      let payload = {};
      try {
        payload = await response.json();
      } catch (e) {
        payload = {};
      }
      
      if (!response.ok) {
        throw new Error(payload.error || '延長に失敗しました');
      }
      
      return payload;
    })
    .then(data => {
      if (data.success) {
        alert(data.message || '有効期限を延長しました');
        location.reload();
      } else {
        alert(data.error || '延長に失敗しました');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert(error.message || 'エラーが発生しました');
    })
    .finally(() => {
      confirmExtendBtn.disabled = false;
    });
  });
}

// 有効期限延長UIの初期化（Turbo遷移でも動作するよう turbo:load でも実行）
function initExtendExpiryPage() {
  if (!document.getElementById('extendExpiryModal')) return;
  
  setupExtendMethodToggle();
  setupExtendExpirySubmit();
  
  const extendDaysInput = document.getElementById('extendDays');
  if (extendDaysInput && extendDaysInput.dataset.bound !== 'true') {
    extendDaysInput.dataset.bound = 'true';
    extendDaysInput.addEventListener('input', updateExpiryPreview);
  }
  
  const extendExpiryModal = document.getElementById('extendExpiryModal');
  if (extendExpiryModal && extendExpiryModal.dataset.previewBound !== 'true') {
    extendExpiryModal.dataset.previewBound = 'true';
    extendExpiryModal.addEventListener('shown.bs.modal', function() {
      updateExpiryPreview();
    });
  }
}

function bootTicketManagementPageScripts() {
  initializeDeleteTicketModal();
  adjustTableSpacing();
  initExtendExpiryPage();
}

// 延長ボタン・日数ボタンはイベント委譲（1回だけ登録）
if (!window.__extendExpiryDelegationBound) {
  window.__extendExpiryDelegationBound = true;
  
  document.addEventListener('click', function(e) {
    const extendBtn = e.target.closest('.extend-expiry-btn');
    if (extendBtn) {
      e.preventDefault();
      e.stopPropagation();
      handleExtendExpiryClick(extendBtn);
      return;
    }
    
    if (e.target.closest('.extend-days-btn')) {
      const btn = e.target.closest('.extend-days-btn');
      const days = btn.getAttribute('data-days');
      const extendDaysInput = document.getElementById('extendDays');
      if (extendDaysInput) {
        extendDaysInput.value = days;
        updateExpiryPreview();
      }
    }
  });
}

document.addEventListener('turbo:load', bootTicketManagementPageScripts);
document.addEventListener('DOMContentLoaded', bootTicketManagementPageScripts);
if (document.readyState !== 'loading') {
  bootTicketManagementPageScripts();
}
  

// ============================================
// ページレイアウト調整
// ============================================

// チケット数に応じてページとカードの余白を調整
function adjustTableSpacing() {
  const container = document.querySelector('.container-lg');
  const ticketCard = document.querySelector('.ticket-card');
  const ticketRows = document.querySelectorAll('tbody tr');
  const ticketCount = ticketRows.length;
  
  if (!container || !ticketCard) return;
  
  container.classList.remove('single-ticket-page', 'few-tickets-page');
  ticketCard.classList.remove('single-ticket', 'few-tickets');
  
  if (ticketCount === 1) {
    container.classList.add('single-ticket-page');
    ticketCard.classList.add('single-ticket');
  } else if (ticketCount <= 2) {
    container.classList.add('few-tickets-page');
    ticketCard.classList.add('few-tickets');
  }
}

// ============================================
// 緊急時のモーダル強制閉じる関数（グローバル）
// ============================================
window.forceCloseModal = function() {
  const controller = document.querySelector('[data-controller*="ticket-management"]');
  
  // Stimulusコントローラーが存在する場合は、そのメソッドを呼ぶ
  if (controller) {
    try {
      const stimulusApp = window.Stimulus || window.Application;
      if (stimulusApp) {
        const controllerInstance = stimulusApp.getControllerForElementAndIdentifier(controller, 'ticket-management');
        if (controllerInstance?.hideDeleteTicketModal) {
          controllerInstance.hideDeleteTicketModal();
          return;
        }
      }
      
      if (controller.stimulusController?.hideDeleteTicketModal) {
        controller.stimulusController.hideDeleteTicketModal();
        return;
      }
    } catch (error) {
      // エラーは無視してフォールバック処理へ
    }
  }
  
  // フォールバック: 手動でモーダルを閉じる
  document.querySelectorAll('.modal').forEach(modal => {
    modal.style.display = 'none';
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
  });
  
  document.body.classList.remove('modal-open');
  document.body.style.overflow = '';
  document.body.style.paddingRight = '';
  document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
  
  if (controller?.stimulusController) {
    controller.stimulusController.isProcessing = false;
  }
};

</script>
