<div class="container-lg my-5">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">
            <i class="fas fa-users me-2 text-primary"></i>ユーザー管理
          </h1>
          <p class="text-muted mb-0">登録ユーザーの一覧と管理</p>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-info" onclick="syncLineUsers()">
            <i class="fab fa-line me-1"></i>LINEユーザー同期
          </button>
          <button type="button" class="btn btn-success" id="addUserBtn">
            <i class="fas fa-user-plus me-1"></i>新規追加
        </button>
        </div>
      </div>
      </div>
    </div>

  <!-- 検索・フィルターセクション -->
  <div class="card mb-4">
    <div class="card-body">
      <%= search_form_for @q, url: admin_users_path, method: :get, html: { class: "row g-3 align-items-end" } do |f| %>
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text">
              <i class="fas fa-search"></i>
            </span>
            <%= f.search_field :name_cont, class: "form-control", placeholder: "名前で検索..." %>
            <button class="btn btn-primary" type="submit">
              <i class="fas fa-search me-1"></i>検索
            </button>
            <% if params[:q].present? %>
              <%= link_to admin_users_path, class: "btn btn-outline-secondary" do %>
                <i class="fas fa-times me-1"></i>リセット
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 統計情報 -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="h4 mb-1"><%= @users.count %></div>
          <div class="small">登録ユーザー数</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="h4 mb-1 text-success"><%= @users.joins(:tickets).distinct.count %></div>
          <div class="small">チケット保有者</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="h4 mb-1 text-info"><%= @users.where.not(line_user_id: [nil, '']).count %></div>
          <div class="small">LINE連携済み</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <div class="h4 mb-1 text-warning"><%= @users.where(line_user_id: [nil, '']).count %></div>
          <div class="small">未連携ユーザー</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ユーザー一覧テーブル -->
  <div class="card">
    <div class="card-header bg-gradient-primary text-white">
      <h5 class="mb-0">
        <i class="fas fa-list me-2"></i>ユーザー一覧
      </h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>ユーザー情報</th>
              <th>LINE連携</th>
              <th>チケット状況</th>
              <th>最終利用日</th>
              <th class="text-center">操作</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                      <div class="fw-semibold">
                      <% if user.display_name_or_name.present? %>
                          <%= link_to user.display_name_or_name, admin_user_path(user), class: "text-decoration-none" %>
                        <% else %>
                          <span class="text-muted fst-italic">未登録</span>
                        <% end %>
                      </div>
                      <div class="small text-muted">
                        ID: <%= user.id %> | <%= l(user.created_at.to_date) %>
                        <% if user.display_name.present? && user.name.present? && user.display_name != user.name %>
                          <br>登録名: <%= user.name %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if user.line_user_id.present? && user.line_user_id != '' %>
                    <span class="badge bg-success">
                      <i class="fab fa-line me-1"></i>連携済み
                    </span>
                  <% else %>
                    <span class="badge bg-secondary">
                      <i class="fas fa-unlink me-1"></i>未連携
                    </span>
                  <% end %>
                </td>
                <td>
                  <div>
                    <% if user.active_ticket_count > 0 %>
                      <span class="badge bg-info">
                        <i class="fas fa-ticket-alt me-1"></i><%= user.active_ticket_count %>回
                      </span>
                    <% end %>
                    <div class="small text-muted">
                      <%= number_to_currency(user.remaining_ticket_value, unit: "¥", precision: 0) %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if user.last_usage_date %>
                    <div class="text-muted">
                      <i class="fas fa-calendar me-1"></i>
                      <%= user.last_usage_date.strftime("%m/%d") %>
                    </div>
                  <% else %>
                    <span class="text-muted small">
                      <i class="fas fa-minus me-1"></i>未利用
                    </span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="btn-group" role="group">
                    <% if user.name.present? %>
                      <%= link_to ticket_management_admin_user_path(user), class: "btn btn-sm btn-outline-primary", title: "チケット管理" do %>
                        <i class="fas fa-ticket-alt"></i>
                      <% end %>
                      <%= link_to admin_user_path(user), class: "btn btn-sm btn-outline-info", title: "詳細" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>
                    <% else %>
                      <span class="text-muted fst-italic small">未登録</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer bg-light">
        <%= paginate @users %>
    </div>
  </div>
</div>

<!-- 新規ユーザー追加モーダル -->
<div id="addUserModal" class="custom-modal" style="display: none;">
  <div class="custom-modal-backdrop" onclick="hideModal()"></div>
  <div class="custom-modal-dialog">
    <div class="custom-modal-content">
      <div class="modal-header bg-gradient-success text-white">
        <h5 class="modal-title fw-bold" id="addUserModalLabel">
          <i class="fas fa-user-plus me-2"></i>新規ユーザー追加
        </h5>
        <button type="button" class="btn-close btn-close-white" onclick="hideModal()" aria-label="Close"></button>
      </div>
      <%= form_with model: [:admin, User.new], local: false, id: "addUserForm", class: "needs-validation", novalidate: true do |form| %>
        <div class="modal-body p-4">
          <!-- 基本情報セクション -->
          <div class="mb-4">
            <h6 class="text-primary fw-bold mb-3">
              <i class="fas fa-user me-2"></i>基本情報
            </h6>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                  <%= form.label :name, "お名前", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-user text-primary"></i>
                    </span>
                    <%= form.text_field :name, class: "form-control", id: "userName", required: true, placeholder: "例: 山田太郎" %>
                  </div>
                  <div class="invalid-feedback">
                    お名前を入力してください。
                  </div>
                </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                  <%= form.label :display_name, "表示名", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-id-card text-primary"></i>
                    </span>
                    <%= form.text_field :display_name, class: "form-control", id: "userDisplayName", placeholder: "例: たろう" %>
                  </div>
                  <small class="form-text text-muted">LINEで表示される名前（任意）</small>
                </div>
              </div>
            </div>
          </div>

          <!-- 連絡先情報セクション -->
          <div class="mb-4">
            <h6 class="text-primary fw-bold mb-3">
              <i class="fas fa-address-book me-2"></i>連絡先情報
            </h6>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                  <%= form.label :phone_number, "電話番号", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-phone text-primary"></i>
                    </span>
                    <%= form.telephone_field :phone_number, class: "form-control", id: "userPhone", placeholder: "例: 090-1234-5678" %>
                  </div>
                </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                  <%= form.label :email, "メールアドレス", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-envelope text-primary"></i>
                    </span>
                    <%= form.email_field :email, class: "form-control", id: "userEmail", placeholder: "例: example@email.com" %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 住所情報セクション -->
          <div class="mb-4">
            <h6 class="text-primary fw-bold mb-3">
              <i class="fas fa-map-marker-alt me-2"></i>住所情報
            </h6>
          <div class="row">
            <div class="col-md-4">
              <div class="mb-3">
                  <%= form.label :postal_code, "郵便番号", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-mail-bulk text-primary"></i>
                    </span>
                    <%= form.text_field :postal_code, class: "form-control", id: "userPostalCode", placeholder: "例: 123-4567" %>
                  </div>
                </div>
            </div>
            <div class="col-md-8">
              <div class="mb-3">
                  <%= form.label :address, "住所", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light align-items-start pt-3">
                      <i class="fas fa-home text-primary"></i>
                    </span>
                    <%= form.text_area :address, class: "form-control", id: "userAddress", rows: 2, placeholder: "例: 東京都渋谷区..." %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- その他情報セクション -->
          <div class="mb-4">
            <h6 class="text-primary fw-bold mb-3">
              <i class="fas fa-info-circle me-2"></i>その他情報
            </h6>
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :birth_date, "生年月日", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fas fa-birthday-cake text-primary"></i>
                    </span>
                    <%= form.date_field :birth_date, class: "form-control", id: "userBirthDate" %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :line_user_id, "LINEユーザーID", class: "form-label fw-semibold text-dark" %>
                  <div class="input-group">
                    <span class="input-group-text bg-light">
                      <i class="fab fa-line text-primary"></i>
                    </span>
                    <%= form.text_field :line_user_id, class: "form-control", id: "userLineId", placeholder: "LINE連携時に自動設定" %>
                  </div>
                  <small class="form-text text-muted">LINE連携時に自動で設定されます</small>
                </div>
              </div>
            </div>
          <div class="mb-3">
              <%= form.label :admin_memo, "管理者メモ", class: "form-label fw-semibold text-dark" %>
              <div class="input-group">
                <span class="input-group-text bg-light align-items-start pt-3">
                  <i class="fas fa-sticky-note text-primary"></i>
                </span>
                <%= form.text_area :admin_memo, class: "form-control", id: "userAdminMemo", rows: 3, placeholder: "初回来店の経緯、アレルギー情報、特記事項など" %>
              </div>
              <small class="form-text text-muted">管理者のみが閲覧できるメモです</small>
            </div>
          </div>

          <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <div>
              <strong>ご注意:</strong> 入力された情報はユーザー管理で使用されます。正確な情報を入力してください。
            </div>
          </div>
      </div>
        <div class="modal-footer bg-light border-0 p-4 pe-5 d-flex justify-content-end">
          <button type="button" class="btn btn-outline-secondary btn-lg px-4 me-4" onclick="hideModal()">
            <i class="fas fa-times me-2"></i>キャンセル
          </button>
          <button type="submit" class="btn btn-success btn-lg px-4" id="saveUserBtn">
            <i class="fas fa-save me-2"></i>ユーザーを追加
        </button>
      </div>
      <% end %>
    </div>
  </div>
</div>

<style>
.bg-gradient-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

.bg-gradient-success {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
}

.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.table td {
  vertical-align: middle;
}

.btn-group .btn {
  border-radius: 0.375rem !important;
}

.btn-group .btn:first-child {
  border-top-left-radius: 0.375rem !important;
  border-bottom-left-radius: 0.375rem !important;
}

.btn-group .btn:last-child {
  border-top-right-radius: 0.375rem !important;
  border-bottom-right-radius: 0.375rem !important;
}

/* カスタムモーダルのスタイリング */
.custom-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1050;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

.custom-modal-dialog {
  position: relative;
  width: 95%;
  max-width: 1000px;
  margin: 0 auto;
  max-height: 90vh;
  overflow-y: auto;
}

.custom-modal-content {
  background: white;
  border-radius: 1rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  overflow: hidden;
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(-50px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  border-bottom: none;
  padding: 1.5rem 2rem 1rem;
}

.modal-body {
  padding: 1rem 2rem;
}

.modal-footer {
  border-top: none;
  padding: 1rem 2rem 1.5rem;
}

.input-group-text {
  border-right: none;
  background-color: #f8f9fa !important;
  border-color: #dee2e6;
}

.form-control {
  border-left: none;
  border-color: #dee2e6;
}

.form-control:focus {
  border-color: #86b7fe;
  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

.form-control-lg {
  padding: 0.75rem 1rem;
  font-size: 1rem;
}

/* アニメーション効果 */
.modal.fade .modal-dialog {
  transition: transform 0.3s ease-out;
  transform: translate(0, -50px);
}

.modal.show .modal-dialog {
  transform: none;
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .modal-dialog {
    margin: 1rem;
  }
  
  .modal-header,
  .modal-body,
  .modal-footer {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  
  .btn-lg {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
}
</style>

<script>
// シンプルで確実な新規追加ボタンの初期化
(function() {
  'use strict';
  
  console.log('🔍 User Management Script Loading...');
  
  // グローバル関数
  window.hideModal = function() {
    const modal = document.getElementById('addUserModal');
    if (modal) {
      console.log('🔍 Hiding modal...');
      modal.style.display = 'none';
      document.body.style.overflow = '';
      console.log('✅ Modal hidden');
    }
  };
  
  window.showModal = function() {
    const modal = document.getElementById('addUserModal');
    if (modal) {
      console.log('🔍 Opening modal...');
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      console.log('✅ Modal shown');
    } else {
      console.error('❌ Modal element not found');
    }
  };
  
  // LINEユーザー同期機能
  window.syncLineUsers = function() {
    const button = event.target;
    const originalText = button.innerHTML;
    
    // ボタンを無効化してローディング表示
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>同期中...';
    
    // CSRFトークンを取得
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    
    console.log('🔄 Starting LINE user sync...');
    
    fetch('/admin/users/sync_line_users', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken
      }
    })
    .then(response => {
      console.log('Response status:', response.status);
      
      if (!response.ok) {
        return response.text().then(text => {
          console.log('Response text:', text);
          try {
            const data = JSON.parse(text);
            throw new Error(data.error || 'LINEユーザー同期に失敗しました');
          } catch (parseError) {
            throw new Error(`サーバーエラーが発生しました。ステータス: ${response.status}`);
          }
        });
      }
      return response.json();
    })
    .then(data => {
      console.log('✅ LINE user sync completed:', data);
      
      // 成功メッセージを表示
      const alertDiv = document.createElement('div');
      alertDiv.className = 'alert alert-success alert-dismissible fade show';
      alertDiv.innerHTML = `
        <i class="fas fa-check-circle me-2"></i>
        LINEユーザーの同期が完了しました！<br>
        <small class="text-muted">
          新規ユーザー: ${data.new_users || 0}人 | 
          更新ユーザー: ${data.updated_users || 0}人 | 
          エラー: ${data.errors || 0}件
        </small>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;
      
      // メッセージを表示する場所を安全に取得
      const container = document.querySelector('.container-lg');
      
      if (container) {
        // コンテナの最初に追加
        container.insertBefore(alertDiv, container.firstChild);
      } else {
        // フォールバック: bodyの最初に追加
        document.body.insertBefore(alertDiv, document.body.firstChild);
      }
      
      // ページをリロード（新しいユーザーを表示するため）
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    })
    .catch(error => {
      console.error('❌ Error syncing LINE users:', error);
      
      // エラーメッセージを表示
      const alertDiv = document.createElement('div');
      alertDiv.className = 'alert alert-danger alert-dismissible fade show';
      alertDiv.innerHTML = `
        <i class="fas fa-exclamation-triangle me-2"></i>
        LINEユーザー同期エラー: ${error.message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;
      
      // メッセージを表示する場所を安全に取得
      const container = document.querySelector('.container-lg');
      
      if (container) {
        // コンテナの最初に追加
        container.insertBefore(alertDiv, container.firstChild);
      } else {
        // フォールバック: bodyの最初に追加
        document.body.insertBefore(alertDiv, document.body.firstChild);
      }
      
      // ボタンを元に戻す
      button.disabled = false;
      button.innerHTML = originalText;
    });
  };
  
  // 初期化関数
  function init() {
    console.log('🔍 Initializing User Management...');
    
    const addUserBtn = document.getElementById('addUserBtn');
    if (!addUserBtn) {
      console.error('❌ Add user button not found');
      return;
    }
    
    console.log('✅ Add user button found');
    
    // 既存のイベントリスナーを削除
    const newBtn = addUserBtn.cloneNode(true);
    addUserBtn.parentNode.replaceChild(newBtn, addUserBtn);
    
    // 新しいイベントリスナーを追加
    newBtn.addEventListener('click', function(e) {
      e.preventDefault();
      console.log('🔍 Add user button clicked');
      window.showModal();
    });
    
    console.log('✅ Event listener added to add user button');
  }
  
  // 複数のタイミングで初期化を試行
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  // Turbo対応
  document.addEventListener('turbo:load', init);
  document.addEventListener('turbo:render', init);
  
  // フォールバック
  setTimeout(init, 100);
  setTimeout(init, 500);
  
  // ESCキーでモーダルを閉じる機能
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('addUserModal');
      if (modal && modal.style.display !== 'none') {
        window.hideModal();
      }
    }
  });
  
})();
