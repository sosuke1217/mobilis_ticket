<% content_for :title, "今日の予約一覧 - Mobilis" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
          <i class="fas fa-calendar-day me-2"></i>今日の予約一覧
        </h1>
        <div class="d-flex gap-2">
          <a href="<%= calendar_admin_reservations_path %>" class="btn btn-outline-primary">
            <i class="fas fa-calendar-alt me-1"></i>カレンダー表示
          </a>
          <a href="<%= new_admin_reservation_path %>" class="btn btn-success">
            <i class="fas fa-plus me-1"></i>新規予約
          </a>
        </div>
      </div>

      <!-- 今日の日付表示 -->
      <div class="alert alert-info">
        <i class="fas fa-calendar me-2"></i>
        <strong><%= Date.current.strftime('%Y年%m月%d日') %></strong>
        (<%= Date.current.strftime('%A') %>)
      </div>

      <!-- 予約一覧 -->
      <% if @today_reservations.any? %>
        <div class="reservations-header mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="fas fa-list me-2"></i>予約一覧 (<%= @today_reservations.count %>件)
            </h5>
            <div class="d-flex gap-2">
              <span class="badge bg-success fs-6">
                <i class="fas fa-clock me-1"></i>今日の予約
              </span>
            </div>
          </div>
        </div>

        <!-- 予約テーブル -->
        <div class="card">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0 modern-table">
                <thead class="table-header-custom">
                  <tr>
                    <th class="time-column">
                      <i class="fas fa-clock me-1"></i>時間
                    </th>
                    <th class="customer-column">
                      <i class="fas fa-user me-1"></i>顧客名
                    </th>
                    <th class="course-column">
                      <i class="fas fa-graduation-cap me-1"></i>コース
                    </th>
                    <th class="status-column">
                      <i class="fas fa-info-circle me-1"></i>ステータス
                    </th>
                    <th class="interval-column">
                      <i class="fas fa-tools me-1"></i>整理時間
                    </th>
                    <th class="note-column">
                      <i class="fas fa-sticky-note me-1"></i>メモ
                    </th>
                    <th class="action-column">
                      <i class="fas fa-cogs me-1"></i>操作
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <% @today_reservations.sort_by(&:start_time).each do |reservation| %>
                    <tr class="<%= reservation.status %>-row reservation-row">
                      <td class="time-cell">
                        <div class="time-display">
                          <div class="start-time"><%= reservation.start_time.strftime('%H:%M') %></div>
                          <div class="time-separator">〜</div>
                          <div class="end-time"><%= reservation.end_time.strftime('%H:%M') %></div>
                        </div>
                      </td>
                      <td class="customer-cell">
                        <div class="customer-info">
                          <div class="customer-avatar-small">
                            <i class="fas fa-user-circle"></i>
                          </div>
                          <div class="customer-details">
                            <div class="customer-name">
                              <% if reservation.user_id.present? %>
                                <a href="<%= admin_user_path(reservation.user_id) %>" 
                                   class="text-decoration-none text-dark hover-primary">
                                  <%= reservation.name.present? ? reservation.name : reservation.user&.name || '未設定' %>
                                </a>
                              <% else %>
                                <%= reservation.name.present? ? reservation.name : '未設定' %>
                              <% end %>
                            </div>
                            <% if reservation.user&.phone_number.present? %>
                              <div class="customer-phone">
                                <i class="fas fa-phone me-1"></i>
                                <small><%= reservation.user.phone_number %></small>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </td>
                      <td class="course-cell">
                        <span class="course-badge-table">
                          <i class="fas fa-graduation-cap me-1"></i>
                          <%= reservation.course %>
                        </span>
                      </td>
                      <td class="status-cell">
                        <span class="badge <%= reservation.status_color %> status-badge-table">
                          <%= reservation.status_text %>
                        </span>
                      </td>
                      <td class="interval-cell">
                        <% if reservation.effective_interval_minutes > 0 %>
                          <span class="interval-badge-table">
                            <i class="fas fa-tools me-1"></i>
                            <%= reservation.effective_interval_minutes %>分
                            <% if reservation.has_individual_interval? %>
                              <i class="fas fa-user-cog ms-1" title="個別設定"></i>
                            <% end %>
                          </span>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td class="note-cell">
                        <% if reservation.note.present? %>
                          <span class="note-text" title="<%= reservation.note %>">
                            <i class="fas fa-sticky-note me-1"></i>
                            <%= truncate(reservation.note, length: 30) %>
                          </span>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td class="action-cell">
                        <div class="action-buttons-table">
                          <a href="<%= ticket_management_admin_user_path(reservation.user_id) %>" 
                             class="btn btn-outline-primary btn-sm" title="チケット管理">
                            <i class="fas fa-ticket-alt me-1"></i>チケット
                          </a>
                          <button type="button" class="btn btn-outline-danger btn-sm" 
                                  onclick="deleteReservation(<%= reservation.id %>)" title="予約削除">
                            <i class="fas fa-trash me-1"></i>削除
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% else %>
        <div class="no-reservations">
          <i class="fas fa-calendar-times fa-4x mb-4"></i>
          <h4 class="text-muted mb-3">今日の予約はありません</h4>
          <p class="text-muted mb-4">新しい予約を作成して、スケジュールを管理しましょう</p>
          <a href="<%= new_admin_reservation_path %>" class="btn btn-success btn-lg">
            <i class="fas fa-plus me-2"></i>新規予約を作成
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
/* モダンなテーブルスタイル */
.modern-table {
  border: none;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  border-radius: 8px;
  overflow: hidden;
}

/* テーブルヘッダー */
.table-header-custom {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-bottom: 2px solid #dee2e6;
}

.table-header-custom th {
  border: none;
  padding: 1rem 0.75rem;
  font-weight: 600;
  color: #495057;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.table-header-custom th i {
  color: #6c757d;
  margin-right: 0.5rem;
}

/* テーブル行 */
.reservation-row {
  transition: all 0.2s ease;
  border-bottom: 1px solid #f1f3f4;
}

.reservation-row:hover {
  background-color: #f8f9fa;
  transform: scale(1.01);
}

/* ステータス別の行スタイル */
.confirmed-row {
  border-left: 4px solid #28a745;
  background-color: #f8fff9;
}

.tentative-row {
  border-left: 4px solid #ffc107;
  background-color: #fffef8;
}

.completed-row {
  border-left: 4px solid #17a2b8;
  background-color: #f8fdff;
}

.cancelled-row {
  border-left: 4px solid #dc3545;
  background-color: #fff8f8;
}

.no_show-row {
  border-left: 4px solid #6c757d;
  background-color: #f8f9fa;
}

/* セルスタイル */
.modern-table td {
  border: none;
  padding: 1rem 0.75rem;
  vertical-align: middle;
}

/* 時間セル */
.time-cell {
  min-width: 120px;
}

.time-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.start-time, .end-time {
  font-weight: 600;
  color: #2c3e50;
  font-size: 0.9rem;
}

.time-separator {
  color: #6c757d;
  font-size: 0.8rem;
}

/* 顧客セル */
.customer-cell {
  min-width: 200px;
}

.customer-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.customer-avatar-small {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1976d2;
  font-size: 1.2rem;
}

.customer-details {
  flex: 1;
}

.customer-name {
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 0.25rem;
  font-size: 0.95rem;
}

.customer-phone {
  color: #6c757d;
  font-size: 0.8rem;
}

/* コースセル */
.course-cell {
  min-width: 120px;
}

.course-badge-table {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #007bff, #0056b3);
  color: white;
  padding: 0.4rem 0.8rem;
  border-radius: 20px;
  font-weight: 500;
  font-size: 0.85rem;
}

/* ステータスセル */
.status-cell {
  min-width: 100px;
}

.status-badge-table {
  font-size: 0.8rem;
  padding: 0.4rem 0.8rem;
  border-radius: 20px;
  font-weight: 500;
}

/* ステータス別の文字色を調整 */
.status-badge-table.bg-success {
  color: #fff !important;
}

.status-badge-table.bg-warning {
  color: #000 !important;
}

.status-badge-table.bg-info {
  color: #fff !important;
}

.status-badge-table.bg-danger {
  color: #fff !important;
}

.status-badge-table.bg-secondary {
  color: #fff !important;
}

/* 整理時間セル */
.interval-cell {
  min-width: 120px;
}

.interval-badge-table {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #28a745, #1e7e34);
  color: white;
  padding: 0.3rem 0.6rem;
  border-radius: 15px;
  font-size: 0.8rem;
  font-weight: 500;
}

/* メモセル */
.note-cell {
  min-width: 150px;
  max-width: 200px;
}

.note-text {
  color: #495057;
  font-size: 0.85rem;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作セル */
.action-cell {
  min-width: 160px;
}

.action-buttons-table {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
}

.action-buttons-table .btn {
  border-radius: 20px;
  font-size: 0.8rem;
  padding: 0.3rem 0.6rem;
  transition: all 0.2s ease;
}

.action-buttons-table .btn:hover {
  transform: translateY(-1px);
}

/* ホバーエフェクト */
.hover-primary:hover {
  color: #007bff !important;
  text-decoration: underline !important;
}

/* 予約がない場合のスタイル */
.no-reservations {
  text-align: center;
  padding: 3rem 1rem;
  background: #f8f9fa;
  border-radius: 12px;
  border: 2px dashed #dee2e6;
}

.no-reservations i {
  color: #6c757d;
  margin-bottom: 1rem;
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .modern-table {
    font-size: 0.85rem;
  }
  
  .table-header-custom th {
    padding: 0.75rem 0.5rem;
    font-size: 0.8rem;
  }
  
  .modern-table td {
    padding: 0.75rem 0.5rem;
  }
  
  .action-buttons-table {
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .action-buttons-table .btn {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }
}
</style>

<script>
// 予約削除
function deleteReservation(reservationId) {
  if (confirm('この予約を削除しますか？')) {
    fetch(`/admin/reservations/${reservationId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (response.ok) {
        location.reload();
      } else {
        alert('削除に失敗しました');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('削除に失敗しました');
    });
  }
}
</script>
