<% content_for :title, "今日の予約一覧 - Mobilis" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
          <i class="fas fa-calendar-day me-2"></i>今日の予約一覧
        </h1>
        <div class="d-flex gap-2">
          <a href="<%= calendar_admin_reservations_path %>" class="btn btn-outline-primary">
            <i class="fas fa-calendar-alt me-1"></i>カレンダー表示
          </a>
          <a href="<%= new_admin_reservation_path %>" class="btn btn-success">
            <i class="fas fa-plus me-1"></i>新規予約
          </a>
        </div>
      </div>

      <!-- 今日の日付表示 -->
      <div class="alert alert-info">
        <i class="fas fa-calendar me-2"></i>
        <strong><%= Date.current.strftime('%Y年%m月%d日') %></strong>
        (<%= Date.current.strftime('%A') %>)
      </div>

      <!-- 予約一覧 -->
      <% if @today_reservations.any? %>
        <div class="reservations-header mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="fas fa-list me-2"></i>予約一覧 (<%= @today_reservations.count %>件)
            </h5>
            <div class="d-flex gap-2">
              <span class="badge bg-success fs-6">
                <i class="fas fa-clock me-1"></i>今日の予約
              </span>
            </div>
          </div>
        </div>

        <!-- 予約カード一覧 -->
        <div class="row g-3">
          <% @today_reservations.sort_by(&:start_time).each do |reservation| %>
            <div class="col-12 col-lg-6 col-xl-4">
              <div class="reservation-card <%= reservation.status %>-card">
                <!-- カードヘッダー（時間とステータス） -->
                <div class="card-header-custom">
                  <div class="time-section">
                    <div class="time-icon">
                      <i class="fas fa-clock"></i>
                    </div>
                    <div class="time-details">
                      <div class="start-time"><%= reservation.start_time.strftime('%H:%M') %></div>
                      <div class="time-separator">〜</div>
                      <div class="end-time"><%= reservation.end_time.strftime('%H:%M') %></div>
                    </div>
                  </div>
                  <div class="status-badge">
                    <span class="badge <%= reservation.status_color %>">
                      <%= reservation.status_text %>
                    </span>
                  </div>
                </div>

                <!-- カードボディ（顧客情報とコース） -->
                <div class="card-body-custom">
                  <!-- 顧客情報 -->
                  <div class="customer-section">
                    <div class="customer-avatar">
                      <i class="fas fa-user-circle"></i>
                    </div>
                    <div class="customer-details">
                      <div class="customer-name">
                        <% if reservation.user_id.present? %>
                          <a href="<%= admin_user_path(reservation.user_id) %>" 
                             class="text-decoration-none text-dark hover-primary">
                            <%= reservation.name.present? ? reservation.name : reservation.user&.name || '未設定' %>
                          </a>
                        <% else %>
                          <%= reservation.name.present? ? reservation.name : '未設定' %>
                        <% end %>
                      </div>
                      <% if reservation.user&.phone_number.present? %>
                        <div class="customer-phone">
                          <i class="fas fa-phone me-1"></i>
                          <small><%= reservation.user.phone_number %></small>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- コース情報 -->
                  <div class="course-section">
                    <div class="course-badge">
                      <i class="fas fa-graduation-cap me-1"></i>
                      <%= reservation.course %>
                    </div>
                  </div>

                  <!-- 整理時間 -->
                  <% if reservation.effective_interval_minutes > 0 %>
                    <div class="interval-section">
                      <div class="interval-badge">
                        <i class="fas fa-tools me-1"></i>
                        <%= reservation.effective_interval_minutes %>分
                        <% if reservation.has_individual_interval? %>
                          <i class="fas fa-user-cog ms-1" title="個別設定"></i>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <!-- メモ -->
                  <% if reservation.note.present? %>
                    <div class="note-section">
                      <div class="note-content" title="<%= reservation.note %>">
                        <i class="fas fa-sticky-note me-1"></i>
                        <%= truncate(reservation.note, length: 50) %>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- カードフッター（操作ボタン） -->
                <div class="card-footer-custom">
                  <div class="action-buttons">
                    <a href="<%= ticket_management_admin_user_path(reservation.user_id) %>" 
                       class="btn btn-outline-primary btn-sm" title="チケット管理">
                      <i class="fas fa-ticket-alt me-1"></i>チケット
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm" 
                            onclick="deleteReservation(<%= reservation.id %>)" title="予約削除">
                      <i class="fas fa-trash me-1"></i>削除
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% else %>
        <div class="no-reservations">
          <i class="fas fa-calendar-times fa-4x mb-4"></i>
          <h4 class="text-muted mb-3">今日の予約はありません</h4>
          <p class="text-muted mb-4">新しい予約を作成して、スケジュールを管理しましょう</p>
          <a href="<%= new_admin_reservation_path %>" class="btn btn-success btn-lg">
            <i class="fas fa-plus me-2"></i>新規予約を作成
          </a>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- 予約編集モーダル -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reservationModalLabel">
          <i class="fas fa-edit me-2"></i>予約編集
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <!-- モーダルの内容はカレンダーページと同じ -->
      </div>
    </div>
  </div>
</div>

<style>
/* 予約カードの基本スタイル */
.reservation-card {
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  border: 1px solid #e9ecef;
  overflow: hidden;
}

.reservation-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

/* ステータス別のカードスタイル */
.confirmed-card {
  border-left: 4px solid #28a745;
}

.tentative-card {
  border-left: 4px solid #ffc107;
}

.completed-card {
  border-left: 4px solid #17a2b8;
}

.cancelled-card {
  border-left: 4px solid #dc3545;
}

.no_show-card {
  border-left: 4px solid #6c757d;
}

/* カードヘッダー */
.card-header-custom {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 1rem;
  border-bottom: 1px solid #dee2e6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-section {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.time-icon {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #007bff, #0056b3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.1rem;
}

.time-details {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 600;
}

.start-time, .end-time {
  font-size: 1.1rem;
  color: #2c3e50;
}

.time-separator {
  color: #6c757d;
  font-weight: 400;
}

.status-badge .badge {
  font-size: 0.8rem;
  padding: 0.5rem 0.75rem;
  border-radius: 20px;
}

/* カードボディ */
.card-body-custom {
  padding: 1.25rem;
}

.customer-section {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.customer-avatar {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1976d2;
  font-size: 1.5rem;
}

.customer-details {
  flex: 1;
}

.customer-name {
  font-size: 1.1rem;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 0.25rem;
}

.customer-phone {
  color: #6c757d;
  font-size: 0.9rem;
}

.course-section {
  margin-bottom: 1rem;
}

.course-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #007bff, #0056b3);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 25px;
  font-weight: 500;
  font-size: 0.9rem;
}

.interval-section {
  margin-bottom: 1rem;
}

.interval-badge {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, #28a745, #1e7e34);
  color: white;
  padding: 0.4rem 0.8rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 500;
}

.note-section {
  margin-bottom: 1rem;
}

.note-content {
  background: #f8f9fa;
  padding: 0.75rem;
  border-radius: 8px;
  color: #495057;
  font-size: 0.9rem;
  border-left: 3px solid #6c757d;
}

/* カードフッター */
.card-footer-custom {
  background: #f8f9fa;
  padding: 1rem;
  border-top: 1px solid #dee2e6;
}

.action-buttons {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
}

.action-buttons .btn {
  border-radius: 20px;
  font-size: 0.85rem;
  padding: 0.4rem 0.8rem;
  transition: all 0.2s ease;
}

.action-buttons .btn:hover {
  transform: translateY(-1px);
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .card-header-custom {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  
  .time-section {
    justify-content: center;
  }
  
  .status-badge {
    text-align: center;
  }
  
  .action-buttons {
    justify-content: center;
  }
}

/* ホバーエフェクト */
.hover-primary:hover {
  color: #007bff !important;
  text-decoration: underline !important;
}

/* 予約がない場合のスタイル */
.no-reservations {
  text-align: center;
  padding: 3rem 1rem;
  background: #f8f9fa;
  border-radius: 12px;
  border: 2px dashed #dee2e6;
}

.no-reservations i {
  color: #6c757d;
  margin-bottom: 1rem;
}
</style>

<script>
// 予約編集モーダルを開く
function openReservationModal(reservationId) {
  // カレンダーページのモーダル機能を再利用
  window.location.href = '/admin/reservations/calendar?edit=' + reservationId;
}

// 予約削除
function deleteReservation(reservationId) {
  if (confirm('この予約を削除しますか？')) {
    fetch(`/admin/reservations/${reservationId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (response.ok) {
        location.reload();
      } else {
        alert('削除に失敗しました');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('削除に失敗しました');
    });
  }
}
</script>
