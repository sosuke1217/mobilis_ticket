<% content_for :title, "今日の予約一覧 - Mobilis" %>

<div class="container-lg my-5">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">
            <i class="fas fa-calendar-day me-2 text-primary"></i>今日の予約一覧
          </h1>
          <p class="text-muted mb-0">本日の予約スケジュール管理</p>
        </div>
        <div class="d-flex gap-2">
          <a href="<%= calendar_admin_reservations_path %>" class="btn btn-outline-primary">
            <i class="fas fa-calendar-alt me-1"></i>カレンダー表示
          </a>
          <a href="<%= new_admin_reservation_path %>" class="btn btn-success">
            <i class="fas fa-plus me-1"></i>新規予約
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 今日の日付表示 -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0 shadow-sm">
        <div class="d-flex align-items-center">
          <i class="fas fa-calendar me-3 text-info fs-4"></i>
          <div>
            <strong class="fs-5"><%= Date.current.strftime('%Y年%m月%d日') %></strong>
            <div class="text-muted"><%= Date.current.strftime('%A') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 予約一覧 -->
  <% if @today_reservations.any? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
              <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>予約一覧
              </h5>
              <span class="badge bg-success fs-6">
                <i class="fas fa-clock me-1"></i><%= @today_reservations.count %>件
              </span>
            </div>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="px-3">
                      <i class="fas fa-clock me-1"></i>時間
                    </th>
                    <th>顧客名</th>
                    <th>
                      <i class="fas fa-graduation-cap me-1"></i>コース
                    </th>
                    <th>
                      <i class="fas fa-info-circle me-1"></i>ステータス
                    </th>
                    <th>
                      <i class="fas fa-tools me-1"></i>整理時間
                    </th>
                    <th>
                      <i class="fas fa-sticky-note me-1"></i>メモ
                    </th>
                    <th class="text-center">
                      <i class="fas fa-cogs me-1"></i>操作
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <% @today_reservations.sort_by(&:start_time).each do |reservation| %>
                    <tr class="<%= reservation.status %>-row">
                      <td class="px-3">
                        <div class="d-flex flex-column align-items-center">
                          <div class="fw-semibold text-primary">
                            <%= reservation.start_time.strftime('%H:%M') %>
                          </div>
                          <div class="text-muted small">〜</div>
                          <div class="fw-semibold text-primary">
                            <%= reservation.end_time.strftime('%H:%M') %>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="flex-shrink-0 me-2">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                              <i class="fas fa-user text-white small"></i>
                            </div>
                          </div>
                          <div class="flex-grow-1">
                            <div class="fw-semibold">
                              <% if reservation.user_id.present? %>
                                <a href="<%= admin_user_path(reservation.user_id) %>" 
                                   class="text-decoration-none text-dark hover-primary">
                                  <%= reservation.name.present? ? reservation.name : reservation.user&.name || '未設定' %>
                                </a>
                              <% else %>
                                <%= reservation.name.present? ? reservation.name : '未設定' %>
                              <% end %>
                            </div>
                            <% if reservation.user&.phone_number.present? %>
                              <div class="small text-muted">
                                <i class="fas fa-phone me-1"></i><%= reservation.user.phone_number %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-primary">
                          <i class="fas fa-graduation-cap me-1"></i>
                          <%= reservation.course %>
                        </span>
                      </td>
                      <td>
                        <span class="badge <%= reservation.status_bootstrap_class %>">
                          <%= reservation.status_text %>
                        </span>
                      </td>
                      <td>
                        <% if reservation.effective_interval_minutes > 0 %>
                          <span class="badge bg-success">
                            <i class="fas fa-tools me-1"></i>
                            <%= reservation.effective_interval_minutes %>分
                            <% if reservation.has_individual_interval? %>
                              <i class="fas fa-user-cog ms-1" title="個別設定"></i>
                            <% end %>
                          </span>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td>
                        <% if reservation.note.present? %>
                          <span class="text-muted" title="<%= reservation.note %>">
                            <i class="fas fa-sticky-note me-1"></i>
                            <%= truncate(reservation.note, length: 30) %>
                          </span>
                        <% else %>
                          <span class="text-muted">-</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <div class="btn-group" role="group">
                          <% if reservation.user_id.present? %>
                            <a href="<%= ticket_management_admin_user_path(reservation.user_id) %>" 
                               class="btn btn-sm btn-outline-primary" title="チケット管理">
                              <i class="fas fa-ticket-alt"></i>
                            </a>
                          <% end %>
                          <button type="button" class="btn btn-sm btn-outline-danger" 
                                  onclick="deleteReservation(<%= reservation.id %>)" title="予約削除">
                            <i class="fas fa-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body text-center py-5">
            <i class="fas fa-calendar-times fa-4x text-muted mb-4"></i>
            <h4 class="text-muted mb-3">今日の予約はありません</h4>
            <p class="text-muted mb-4">新しい予約を作成して、スケジュールを管理しましょう</p>
            <a href="<%= new_admin_reservation_path %>" class="btn btn-success btn-lg">
              <i class="fas fa-plus me-2"></i>新規予約を作成
            </a>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
/* ステータス別の行スタイル */
.confirmed-row {
  border-left: 4px solid #28a745;
  background-color: #f8fff9;
}

.tentative-row {
  border-left: 4px solid #ffc107;
  background-color: #fffef8;
}

.completed-row {
  border-left: 4px solid #17a2b8;
  background-color: #f8fdff;
}

.cancelled-row {
  border-left: 4px solid #dc3545;
  background-color: #fff8f8;
}

.no_show-row {
  border-left: 4px solid #6c757d;
  background-color: #f8f9fa;
}

/* テーブルスタイル */
.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.table td {
  vertical-align: middle;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

/* ホバーエフェクト */
.hover-primary:hover {
  color: #007bff !important;
  text-decoration: underline !important;
}

/* レスポンシブ対応 */
@media (max-width: 768px) {
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .badge {
    font-size: 0.75rem !important;
  }
  
  .btn-group {
    flex-direction: column;
  }
  
  .btn-group .btn {
    margin-bottom: 0.25rem;
  }
}
</style>

<script>
// 予約削除
function deleteReservation(reservationId) {
  if (confirm('この予約を削除しますか？')) {
    fetch(`/admin/reservations/${reservationId}`, {
      method: 'DELETE',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (response.ok) {
        location.reload();
      } else {
        alert('削除に失敗しました');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('削除に失敗しました');
    });
  }
}
</script>
