<!-- 👇 コントローラ追加 -->
<div class="container my-4">
  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
      <h2 class="mb-0">ご予約フォーム（管理者）</h2>
    </div>

    <div class="card-body">
      <% if @reservation.errors.any? %>
        <div class="alert alert-danger">
          <strong>入力に誤りがあります：</strong>
          <ul class="mb-0">
            <% @reservation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @reservation, url: admin_reservations_path, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, "お名前", class: "form-label" %>
          <div class="position-relative">
            <%= f.text_field :name, class: "form-control", id: "reservation_name", placeholder: "名前を入力してください（2文字以上）" %>
            <div class="user-search-results" id="name-search-results" style="display: none;"></div>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :phone_number, "電話番号", class: "form-label" %>
          <%= f.text_field :phone_number, class: "form-control", id: "reservation_phone_number" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.text_field :email, class: "form-control", id: "reservation_email" %>
        </div>

        <!-- 日付ピッカー -->
        <div class="mb-3">
          <label for="date-picker" class="form-label">予約日</label>
          <input type="date" id="date-picker" class="form-control" />
        </div>

        <!-- 空き時間セレクト + hidden field -->
        <div class="mb-3">
          <label class="form-label">空き時間</label>
          <div id="available-times">
            <select class="form-select" id="time-select" disabled>
              <option>日付を選択してください</option>
            </select>
          </div>
          <%= f.hidden_field :start_time, id: "reservation_start_time" %>
        </div>

        <div class="mb-3">
          <%= f.label :course, "コース", class: "form-label" %>
          <%= f.select :course, ["40分", "60分", "80分"], { prompt: "選択してください" }, class: "form-select" %>
        </div>

        <div class="mb-3">
          <%= f.label :note, "メモ（任意）", class: "form-label" %>
          <%= f.text_area :note, class: "form-control", rows: 3 %>
        </div>

        <div class="text-end">
          <%= f.submit "予約する", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
/* ユーザー検索結果のスタイル */
.user-search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #ddd;
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  max-height: 300px;
  overflow-y: auto;
  z-index: 1000;
}

.user-search-item {
  padding: 10px 15px;
  border-bottom: 1px solid #eee;
  cursor: pointer;
  transition: background-color 0.2s;
}

.user-search-item:hover {
  background-color: #f8f9fa;
}

.user-search-item:last-child {
  border-bottom: none;
}

.user-name {
  font-weight: 600;
  color: #333;
  margin-bottom: 5px;
}

.user-details {
  font-size: 0.9rem;
  color: #666;
}

.user-tickets {
  color: #28a745;
  font-weight: 600;
}

/* アラートメッセージのスタイル */
.alert {
  margin-bottom: 1rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const datePicker = document.getElementById('date-picker');
  const timeSelect = document.getElementById('time-select');
  const startTimeField = document.getElementById('reservation_start_time');
  const courseSelect = document.querySelector('select[name="reservation[course]"]');
  
  // 名前検索機能の初期化
  initializeUserSearch();

  // 日付が選択されたときの処理
  datePicker.addEventListener('change', function(event) {
    event.preventDefault();
    event.stopPropagation();
    const selectedDate = this.value;
    if (selectedDate) {
      loadAvailableTimes(selectedDate);
    }
  });

  // コースが選択されたときの処理
  courseSelect.addEventListener('change', function(event) {
    event.preventDefault();
    event.stopPropagation();
    const selectedDate = datePicker.value;
    if (selectedDate && this.value) {
      loadAvailableTimes(selectedDate);
    }
  });

  // 空き時間を取得
  function loadAvailableTimes(date) {
    const course = courseSelect.value;
    if (!course) {
      clearTimeSelect();
      timeSelect.innerHTML = '<option>コースを選択してください</option>';
      timeSelect.disabled = true;
      return;
    }

    // コースの時間を抽出
    const duration = extractDuration(course);
    
    // ローディング表示
    clearTimeSelect();
    timeSelect.innerHTML = '<option>空き時間を取得中...</option>';
    timeSelect.disabled = true;

    // APIから空き時間を取得
    fetch(`/admin/reservations/available_times?date=${date}&duration=${duration}`)
      .then(response => response.json())
      .then(data => {
        if (data.success && data.slots.length > 0) {
          // 空き時間をセレクトに設定
          clearTimeSelect();
          timeSelect.innerHTML = '<option value="">時間を選択してください</option>';
          data.slots.forEach(slot => {
            const option = document.createElement('option');
            option.value = slot.start_datetime;
            option.textContent = slot.display;
            timeSelect.appendChild(option);
          });
          timeSelect.disabled = false;
        } else {
          clearTimeSelect();
          timeSelect.innerHTML = '<option>空き時間がありません</option>';
          timeSelect.disabled = true;
        }
      })
      .catch(error => {
        console.error('空き時間の取得に失敗しました:', error);
        clearTimeSelect();
        timeSelect.innerHTML = '<option>エラーが発生しました</option>';
        timeSelect.disabled = true;
      });
  }

  // セレクトボックスの内容を安全にクリアする関数
  function clearTimeSelect() {
    try {
      // 既存のオプションを安全に削除
      while (timeSelect.firstChild) {
        timeSelect.removeChild(timeSelect.firstChild);
      }
    } catch (error) {
      console.warn('セレクトボックスのクリア中にエラーが発生しました:', error);
      // エラーが発生した場合はinnerHTMLを使用
      timeSelect.innerHTML = '';
    }
  }

  // 時間が選択されたときの処理
  timeSelect.addEventListener('change', function() {
    if (this.value) {
      startTimeField.value = this.value;
    }
  });

  // コースの時間を抽出する関数
  function extractDuration(courseString) {
    const match = courseString.match(/(\d+)分/);
    return match ? parseInt(match[1]) : 60;
  }

  // 今日の日付をデフォルトで設定
  const today = new Date().toISOString().split('T')[0];
  datePicker.value = today;
  datePicker.dispatchEvent(new Event('change'));

  // 名前検索機能の初期化
  function initializeUserSearch() {
    const nameInput = document.getElementById('reservation_name');
    const resultsElement = document.getElementById('name-search-results');
    let searchTimeout;

    if (nameInput && resultsElement) {
      // 入力時の検索
      nameInput.addEventListener('input', function() {
        const query = this.value.trim();
        
        if (searchTimeout) {
          clearTimeout(searchTimeout);
        }
        
        if (query.length < 2) {
          hideUserSearchResults(resultsElement);
          return;
        }
        
        searchTimeout = setTimeout(() => {
          searchUsers(query, resultsElement);
        }, 300);
      });
      
      // フォーカスアウト時に結果を隠す
      nameInput.addEventListener('blur', function() {
        setTimeout(() => {
          hideUserSearchResults(resultsElement);
        }, 200);
      });
      
      // フォーカス時に結果を表示（入力がある場合）
      nameInput.addEventListener('focus', function() {
        const query = this.value.trim();
        if (query.length >= 2) {
          searchUsers(query, resultsElement);
        }
      });
    }
  }

  // ユーザー検索
  function searchUsers(query, resultsElement) {
    fetch(`/admin/reservations/search_users?query=${encodeURIComponent(query)}`)
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          displayUserSearchResults(data.users, resultsElement);
        } else {
          console.error('❌ User search failed:', data.message);
          hideUserSearchResults(resultsElement);
        }
      })
      .catch(error => {
        console.error('❌ Error searching users:', error);
        hideUserSearchResults(resultsElement);
      });
  }

  // 検索結果の表示
  function displayUserSearchResults(users, resultsElement) {
    if (!resultsElement) return;
    
    if (users.length === 0) {
      resultsElement.innerHTML = '<div class="user-search-item">該当するユーザーが見つかりません</div>';
      resultsElement.style.display = 'block';
      return;
    }
    
    const resultsHtml = users.map(user => `
      <div class="user-search-item" onclick="selectUser(${user.id}, '${user.name}', '${user.phone_number || ''}', '${user.email || ''}')">
        <div class="user-name">${user.name}</div>
        <div class="user-details">
          📞 ${user.phone_number || '未設定'} | 📧 ${user.email || '未設定'}
          ${user.active_tickets > 0 ? `<span class="user-tickets"> | 🎫 残${user.active_tickets}枚</span>` : ''}
          ${user.last_visit !== 'なし' ? ` | 📅 最終来店: ${user.last_visit}` : ''}
        </div>
      </div>
    `).join('');
    
    resultsElement.innerHTML = resultsHtml;
    resultsElement.style.display = 'block';
  }

  // ユーザー選択
  function selectUser(userId, name, phone, email) {
    // フォームフィールドを更新
    const nameField = document.getElementById('reservation_name');
    const phoneField = document.getElementById('reservation_phone_number');
    const emailField = document.getElementById('reservation_email');
    
    if (nameField) nameField.value = name;
    if (phoneField) phoneField.value = phone;
    if (emailField) emailField.value = email;
    
    // 検索結果を隠す
    const resultsElement = document.getElementById('name-search-results');
    if (resultsElement) {
      hideUserSearchResults(resultsElement);
    }
    
    // 成功メッセージ
    showMessage(`既存ユーザー「${name}」を選択しました`, 'success');
  }

  // 検索結果を隠す
  function hideUserSearchResults(resultsElement) {
    if (resultsElement) {
      resultsElement.style.display = 'none';
      resultsElement.innerHTML = '';
    }
  }

  // メッセージ表示
  function showMessage(message, type = 'info') {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type === 'success' ? 'success' : 'info'} alert-dismissible fade show`;
    alertDiv.innerHTML = `
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    const form = document.querySelector('form');
    if (form) {
      form.insertBefore(alertDiv, form.firstChild);
      
      // 3秒後に自動で消す
      setTimeout(() => {
        if (alertDiv.parentNode) {
          alertDiv.remove();
        }
      }, 3000);
    }
  }
});
</script>
