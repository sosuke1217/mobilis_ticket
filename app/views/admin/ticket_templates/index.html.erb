<div class="container-lg my-5">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">
            <i class="fas fa-tags me-2 text-primary"></i>チケットテンプレート管理
          </h1>
          <p class="text-muted mb-0">チケットの種類と価格の設定</p>
        </div>
        <%= link_to new_admin_ticket_template_path, class: "btn btn-success" do %>
          <i class="fas fa-plus me-1"></i>新規作成
        <% end %>
      </div>
    </div>
  </div>

  <!-- 統計セクション -->
  <div class="row mb-4">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-gradient-info text-white">
        <div class="card-body text-center">
          <div class="h4 mb-1"><%= @templates.count %></div>
          <div class="small">テンプレート数</div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-gradient-success text-white">
        <div class="card-body text-center">
          <div class="h4 mb-1">
            ¥<%= number_with_delimiter(@templates.sum(&:price)) %>
          </div>
          <div class="small">総価格</div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-gradient-warning text-white">
        <div class="card-body text-center">
          <div class="h4 mb-1"><%= @templates.sum(&:total_count) %></div>
          <div class="small">総回数</div>
        </div>
      </div>
    </div>
  </div>

  <!-- テンプレート一覧 -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <h5 class="mb-0">
        <i class="fas fa-list me-2"></i>テンプレート一覧
      </h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="px-3">テンプレート名</th>
              <th>価格・回数</th>
              <th>有効期間</th>
              <th class="text-center">操作</th>
            </tr>
          </thead>
          <tbody>
            <% @templates.each do |template| %>
              <tr>
                <td class="px-3">
                  <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                      <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fas fa-tag text-white"></i>
                      </div>
                    </div>
                    <div class="flex-grow-1">
                      <div class="fw-semibold"><%= template.name %></div>
                      <div class="small text-muted">ID: <%= template.id %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-3">
                      <span class="badge bg-success fs-6">
                        ¥<%= number_with_delimiter(template.price) %>
                      </span>
                    </div>
                    <div class="text-muted">
                      <i class="fas fa-hashtag me-1"></i><%= template.total_count %>回
                      <br>
                      <small class="text-muted">
                        ¥<%= number_with_delimiter(template.price / template.total_count) %>/回
                      </small>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="me-2">
                      <span class="badge bg-info">
                        <i class="fas fa-calendar me-1"></i><%= template.expiry_days %>日
                      </span>
                    </div>
                    <div class="small text-muted">
                      <% if template.expiry_days == 365 %>
                        <i class="fas fa-infinity me-1"></i>約1年
                      <% elsif template.expiry_days == 180 %>
                        <i class="fas fa-calendar-half me-1"></i>約6ヶ月
                      <% elsif template.expiry_days == 90 %>
                        <i class="fas fa-calendar-quarter me-1"></i>約3ヶ月
                      <% elsif template.expiry_days == 30 %>
                        <i class="fas fa-calendar-week me-1"></i>約1ヶ月
                      <% else %>
                        <i class="fas fa-calendar-day me-1"></i><%= template.expiry_days %>日間
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="text-center">
                  <div class="btn-group" role="group">
                    <%= link_to edit_admin_ticket_template_path(template), 
                        class: "btn btn-sm btn-outline-primary", 
                        title: "編集" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= button_to admin_ticket_template_path(template),
                        method: :delete,
                        form: { 
                          data: { 
                            turbo_stream: true,
                            confirm: "このテンプレートを削除しますか？\n\n※既に発行済みのチケットには影響しません。"
                          } 
                        },
                        class: "btn btn-sm btn-outline-danger",
                        title: "削除" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% if @templates.empty? %>
      <div class="card-body text-center py-5">
        <div class="text-muted">
          <i class="fas fa-tags fa-3x mb-3"></i>
          <h5>テンプレートがありません</h5>
          <p class="mb-0">新しいテンプレートを作成してチケットを発行しましょう</p>
          <%= link_to new_admin_ticket_template_path, class: "btn btn-primary mt-3" do %>
            <i class="fas fa-plus me-1"></i>最初のテンプレートを作成
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<style>
.bg-gradient-info {
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
}

.bg-gradient-success {
  background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);
}

.bg-gradient-warning {
  background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
}

.table th {
  border-top: none;
  font-weight: 600;
  color: #495057;
}

.table td {
  vertical-align: middle;
}

.btn-group .btn {
  border-radius: 0.375rem !important;
}

.btn-group .btn:first-child {
  border-top-left-radius: 0.375rem !important;
  border-bottom-left-radius: 0.375rem !important;
}

.btn-group .btn:last-child {
  border-top-right-radius: 0.375rem !important;
  border-bottom-right-radius: 0.375rem !important;
}

@media (max-width: 768px) {
  .btn-group {
    flex-direction: column;
  }
  
  .btn-group .btn {
    border-radius: 0.375rem !important;
    margin-bottom: 0.25rem;
  }
  
  .table-responsive {
    font-size: 0.875rem;
  }
  
  .badge {
    font-size: 0.75rem !important;
  }
}
</style>
