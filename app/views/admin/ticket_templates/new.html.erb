<div class="container-lg my-5">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">
            <i class="fas fa-plus me-2 text-success"></i>新規テンプレート作成
          </h1>
          <p class="text-muted mb-0">新しいチケットテンプレートを設定します</p>
        </div>
        <%= link_to admin_ticket_templates_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>一覧に戻る
        <% end %>
      </div>
    </div>
  </div>

  <!-- メインコンテンツ -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>テンプレート情報
          </h5>
        </div>
        <div class="card-body">
          <%= render partial: "form", locals: { template: @template } %>
        </div>
      </div>
    </div>
    
    <!-- サイドバー -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="fas fa-info-circle me-2"></i>入力ガイド
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <h6 class="fw-semibold">
              <i class="fas fa-tag me-1 text-primary"></i>テンプレート名
            </h6>
            <p class="small text-muted mb-0">
              例：月額プラン、回数券、特別プランなど
            </p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-semibold">
              <i class="fas fa-hashtag me-1 text-success"></i>回数
            </h6>
            <p class="small text-muted mb-0">
              このチケットで利用できる回数を設定
            </p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-semibold">
              <i class="fas fa-calendar me-1 text-warning"></i>有効期間
            </h6>
            <p class="small text-muted mb-0">
              発行日から何日間有効かを設定
            </p>
          </div>
          
          <div class="mb-3">
            <h6 class="fw-semibold">
              <i class="fas fa-yen-sign me-1 text-danger"></i>価格
            </h6>
            <p class="small text-muted mb-0">
              チケット全体の価格を設定
            </p>
          </div>
          
          <hr>
          
          <div class="alert alert-info small">
            <i class="fas fa-lightbulb me-1"></i>
            <strong>ヒント：</strong>1回あたりの価格は自動で計算されます
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.form-label {
  font-weight: 600;
  color: #495057;
}

.form-control:focus {
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.btn-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
  border: none;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
}

@media (max-width: 768px) {
  .col-lg-4 {
    margin-top: 1rem;
  }
}
</style>
