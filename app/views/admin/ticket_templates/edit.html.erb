<div class="container-lg my-5">
  <!-- ヘッダーセクション -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">
            <i class="fas fa-edit me-2 text-warning"></i>テンプレート編集
          </h1>
          <p class="text-muted mb-0">チケットテンプレートの設定を変更します</p>
        </div>
        <%= link_to admin_ticket_templates_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i>一覧に戻る
        <% end %>
      </div>
    </div>
  </div>

  <!-- メインコンテンツ -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>テンプレート情報
          </h5>
        </div>
        <div class="card-body">
          <%= render partial: "form", locals: { template: @template } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.form-label {
  font-weight: 600;
  color: #495057;
}

.form-control:focus {
  border-color: #007bff;
  box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
}

.btn-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
  border: none;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
}

@media (max-width: 768px) {
  .col-lg-4 {
    margin-top: 1rem;
  }
}
</style>
