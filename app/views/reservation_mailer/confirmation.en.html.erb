<!-- app/views/reservation_mailer/confirmation.en.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= @tentative ? "Booking Request Received" : "Reservation Confirmed" %></title>
  <style>
    body { 
      font-family: Arial, sans-serif; 
      line-height: 1.6; 
      color: #333; 
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header { 
      background: #007bff; 
      color: white; 
      padding: 20px; 
      text-align: center; 
      border-radius: 8px 8px 0 0;
    }
    .content { 
      padding: 20px; 
      background: #f8f9fa; 
      border-radius: 0 0 8px 8px;
    }
    .reservation-details { 
      background: white; 
      padding: 20px; 
      border-radius: 8px; 
      margin: 15px 0;
      border-left: 4px solid #007bff;
    }
    .footer { 
      padding: 20px; 
      text-align: center; 
      color: #666; 
      font-size: 14px;
      background: #e9ecef;
      border-radius: 8px;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1><%= @salon_name %></h1>
    <h2><%= @tentative ? "🕒 Booking Request Received" : "✅ Reservation Confirmed" %></h2>
  </div>
  
  <div class="content">
    <p>Dear <strong><%= @user.name %></strong>,</p>
    
    <% if @tentative %>
      <p>We have received your booking request with the details below.<br>
      Your appointment is not confirmed yet. We will send another email after reviewing the request.</p>
    <% else %>
      <p>Thank you for choosing our services.<br>
      Your reservation has been confirmed with the following details:</p>
    <% end %>
    
    <div class="reservation-details">
      <h3>📅 Reservation Details</h3>
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; font-weight: bold; width: 120px;">Date & Time:</td>
          <td style="padding: 8px 0;"><%= @reservation.start_time.strftime('%B %d, %Y at %H:%M') %> - <%= @reservation.end_time.strftime('%H:%M') %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">Course:</td>
          <td style="padding: 8px 0;"><%= @reservation.course %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">Status:</td>
          <td style="padding: 8px 0;"><%= @reservation.status_text %></td>
        </tr>
        <% if @reservation.note.present? %>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">Notes:</td>
          <td style="padding: 8px 0;"><%= @reservation.note %></td>
        </tr>
        <% end %>
      </table>
    </div>

    <% if @reservation_url.present? %>
    <p style="text-align: center; margin: 24px 0;">
      <a href="<%= @reservation_url %>" style="display: inline-block; padding: 12px 22px; background: #0879A6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold;">
        View Reservation Details
      </a><br>
      <small>Do not share this private link with anyone.</small>
    </p>
    <% end %>

    <% if @tentative %>
      <p>Please wait for your confirmation email.<br>
      If you have any questions, please don't hesitate to contact us.</p>
    <% else %>
      <p>If you have any questions, please don't hesitate to contact us.<br>
      We look forward to seeing you on the day of your appointment.</p>
    <% end %>
  </div>
  
  <div class="footer">
    <p><strong><%= @salon_name %></strong><br>
    TEL: 080-9692-1177<br>
    Email: mobilis.stretch@gmail.com<br>
    Business Hours: 10:00 - 20:00</p>
  </div>
</body>
</html>
