<!-- app/views/reservation_mailer/confirmation.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= @tentative ? "仮予約受付" : "予約確定" %></title>
  <style>
    body { 
      font-family: Arial, sans-serif; 
      line-height: 1.6; 
      color: #333; 
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header { 
      background: #007bff; 
      color: white; 
      padding: 20px; 
      text-align: center; 
      border-radius: 8px 8px 0 0;
    }
    .content { 
      padding: 20px; 
      background: #f8f9fa; 
      border-radius: 0 0 8px 8px;
    }
    .reservation-details { 
      background: white; 
      padding: 20px; 
      border-radius: 8px; 
      margin: 15px 0;
      border-left: 4px solid #007bff;
    }
    .footer { 
      padding: 20px; 
      text-align: center; 
      color: #666; 
      font-size: 14px;
      background: #e9ecef;
      border-radius: 8px;
      margin-top: 20px;
    }
    .highlight {
      background: #fff3cd;
      padding: 10px;
      border-radius: 4px;
      border-left: 4px solid #ffc107;
      margin: 10px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1><%= @salon_name %></h1>
    <h2><%= @tentative ? "🕒 仮予約を受け付けました" : "✅ ご予約が確定しました" %></h2>
  </div>
  
  <div class="content">
    <p><strong><%= @user.name %></strong> 様</p>
    
    <% if @tentative %>
      <p>ご予約リクエストを受け付けました。<br>
      現在はまだ予約確定前です。内容を確認後、改めて予約確定メールをお送りします。</p>
    <% else %>
      <p>ご予約ありがとうございます。<br>
      以下の内容でご予約が確定しました。</p>
    <% end %>
    
    <div class="reservation-details">
      <h3>📅 予約詳細</h3>
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; font-weight: bold; width: 120px;">予約日時:</td>
          <td style="padding: 8px 0;"><%= @reservation.start_time.strftime('%Y年%m月%d日 %H:%M') %> ～ <%= @reservation.end_time.strftime('%H:%M') %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">コース:</td>
          <td style="padding: 8px 0;"><%= @reservation.course %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">ステータス:</td>
          <td style="padding: 8px 0;"><%= @reservation.status_text %></td>
        </tr>
        <% if @reservation.note.present? %>
        <tr>
          <td style="padding: 8px 0; font-weight: bold;">備考:</td>
          <td style="padding: 8px 0;"><%= @reservation.note %></td>
        </tr>
        <% end %>
      </table>
    </div>

    <p style="text-align: center; margin: 24px 0;">
      <a href="<%= @reservation_url %>" style="display: inline-block; padding: 12px 22px; background: #0879A6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold;">
        予約内容を確認する
      </a><br>
      <small>この専用リンクは他の方へ共有しないでください。</small>
    </p>

    
    <% if @tentative %>
      <p>確定のご連絡まで、しばらくお待ちください。<br>
      ご不明な点がございましたら、お気軽にお問い合わせください。</p>
    <% else %>
      <p>ご不明な点がございましたら、お気軽にお問い合わせください。<br>
      当日お会いできることを楽しみにしております。</p>
    <% end %>
  </div>
  
  <div class="footer">
    <p><strong><%= @salon_name %></strong><br>
    TEL: 080-9692-1177<br>
    Email: mobilis.stretch@gmail.com<br>
    営業時間: 10:00 - 20:00</p>
  </div>
</body>
</html>
