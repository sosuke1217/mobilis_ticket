<% content_for :title, "予約受付完了 / Reservation Received" %>

<div class="container booking-complete-page my-4 my-md-5">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
      <div class="card booking-complete-card shadow-lg">
        <div class="booking-complete-hero text-center">
          <div class="complete-icon"><i class="fas fa-check"></i></div>
          <% if @reservation.tentative? %>
            <h1>仮予約を受け付けました</h1>
            <p>Your reservation request has been received</p>
          <% else %>
            <h1>予約内容</h1>
            <p>Reservation details</p>
          <% end %>
        </div>

        <div class="card-body p-4 p-md-5">
          <% if flash[:alert] %>
            <div class="alert alert-danger" role="alert"><%= flash[:alert] %></div>
          <% end %>

          <div class="next-step-notice <%= 'confirmed' if @reservation.confirmed? %>">
            <% if @reservation.tentative? %>
              <i class="fas fa-clock"></i>
              <div>
                <strong>まだ正式確定ではありません / Not yet confirmed</strong>
                <p>内容を確認後、確定のご連絡をお送りします。<br>We will contact you after reviewing your request.</p>
              </div>
            <% elsif @reservation.confirmed? %>
              <i class="fas fa-check-circle"></i>
              <strong>予約は確定しています / Your reservation is confirmed</strong>
            <% else %>
              <strong><%= @reservation.status_text %></strong>
            <% end %>
          </div>

          <section class="summary-section">
            <h2>予約内容 / Reservation Summary</h2>
            <dl class="summary-list">
              <div><dt>メニュー / Menu</dt><dd><%= @reservation.course %></dd></div>
              <div>
                <dt>日時 / Date &amp; Time</dt>
                <dd>
                  <%= @reservation.start_time.strftime('%Y年%-m月%-d日 %H:%M') %>–<%= @reservation.end_time.strftime('%H:%M') %><br>
                  <small><%= @reservation.start_time.strftime('%B %-d, %Y %H:%M') %>–<%= @reservation.end_time.strftime('%H:%M') %></small>
                </dd>
              </div>
              <div><dt>料金 / Price</dt><dd>¥<%= number_with_delimiter(@reservation.get_price) %></dd></div>
              <div><dt>予約番号 / Reservation ID</dt><dd>#<%= @reservation.id %></dd></div>
            </dl>
          </section>

          <% if @reservation.user&.email.present? %>
            <section class="email-notice">
              <i class="fas fa-envelope"></i>
              <div>
                <h2>確認メールを送信しました / Confirmation email sent</h2>
                <p><%= masked_email(@reservation.user.email) %></p>
                <small>届かない場合は迷惑メールフォルダをご確認ください。<br>If you do not see it, please check your spam folder.</small>
              </div>
            </section>
          <% end %>

          <div class="privacy-note">
            <i class="fas fa-shield-alt"></i>
            氏名・電話番号・住所は安全のため、この画面には表示していません。<br>
            <span>Name, phone number and address are hidden for your privacy.</span>
          </div>

          <div class="action-buttons">
            <a href="https://www.mobilis-stretch.com/" class="btn btn-primary btn-lg">
              <i class="fas fa-home me-2"></i>公式サイトへ戻る / Back to Website
            </a>
            <a href="https://www.mobilis-stretch.com/#contact" class="btn btn-outline-primary btn-lg">
              <i class="fas fa-comment-dots me-2"></i>LINE・WhatsAppで相談 / Contact Us
            </a>
          </div>

          <% if !@reservation.cancelled? && @reservation.cancellable? %>
            <div class="secondary-actions">
              <%= link_to cancel_public_booking_path(@reservation), class: "cancel-link",
                    data: { turbo_method: :post, turbo_confirm: "本当にキャンセルしますか？\nAre you sure you want to cancel?" } do %>
                予約をキャンセル / Cancel reservation
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.booking-complete-card { border: 0; border-radius: 18px; overflow: hidden; }
.booking-complete-hero { padding: 34px 24px 30px; background: linear-gradient(135deg, #0879A6, #0b91b8); color: #fff; }
.complete-icon { display: inline-flex; width: 64px; height: 64px; align-items: center; justify-content: center; margin-bottom: 16px; border-radius: 50%; background: rgba(255,255,255,.18); font-size: 1.8rem; }
.booking-complete-hero h1 { margin: 0; font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 700; }
.booking-complete-hero p { margin: 6px 0 0; opacity: .92; }
.next-step-notice, .email-notice { display: flex; gap: 16px; padding: 18px 20px; border-radius: 12px; }
.next-step-notice { margin-bottom: 28px; background: #fff8e1; border: 1px solid #ffe08a; color: #594500; }
.next-step-notice.confirmed { background: #eaf8ef; border-color: #a9dfba; color: #175b2c; }
.next-step-notice > i, .email-notice > i { margin-top: 3px; font-size: 1.25rem; }
.next-step-notice p, .email-notice p { margin: 5px 0 0; }
.summary-section h2, .email-notice h2 { margin: 0; color: #0879A6; font-size: 1.08rem; font-weight: 700; }
.summary-list { margin: 14px 0 28px; padding: 0 20px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; }
.summary-list > div { display: grid; grid-template-columns: minmax(150px,.8fr) minmax(0,1.5fr); gap: 24px; padding: 15px 0; border-bottom: 1px solid #e2e8f0; }
.summary-list > div:last-child { border-bottom: 0; }
.summary-list dt { color: #64748b; font-size: .9rem; }
.summary-list dd { margin: 0; color: #1e293b; font-weight: 700; overflow-wrap: anywhere; }
.summary-list dd small { color: #64748b; font-weight: 500; }
.email-notice { margin-bottom: 18px; background: #eaf6fb; border: 1px solid #b8ddea; color: #284b59; }
.privacy-note { margin-bottom: 26px; color: #64748b; font-size: .84rem; text-align: center; }
.privacy-note span { font-size: .8rem; }
.action-buttons { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
.action-buttons .btn { display: flex; min-height: 52px; align-items: center; justify-content: center; border-radius: 10px; font-size: .96rem; font-weight: 700; }
.action-buttons .btn-primary { background: #0879A6; border-color: #0879A6; }
.action-buttons .btn-outline-primary { color: #0879A6; border-color: #0879A6; }
.secondary-actions { margin-top: 24px; text-align: center; }
.cancel-link { color: #a33a3a; font-size: .9rem; }

@media (max-width: 767px) {
  .booking-complete-page { margin-top: 16px !important; margin-bottom: 16px !important; }
  .booking-complete-card .card-body { padding: 24px 18px !important; }
  .booking-complete-hero { padding: 28px 18px 25px; }
  .summary-list > div { grid-template-columns: 1fr; gap: 4px; }
  .action-buttons { grid-template-columns: 1fr; }
}
</style>
