<!-- app/views/public/bookings/new.html.erb -->
<% content_for :title, "Mobilis｜ご予約 / Reservation" %>
<div class="container my-4 my-md-5">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
      <div class="card shadow-lg timerex-style">
        <div class="card-header timerex-header text-center">
          <h2 class="mb-0">
            <i class="fas fa-calendar-check me-2"></i>
            Mobilis｜ご予約（身体評価・調整／オンライン分析）<br>
            <small style="font-size: 0.6em; opacity: 0.9;">Mobilis | Reservation (Body Assessment & Adjustment / Online Analysis)</small>
          </h2>
        </div>
        
        <div class="card-body p-4 p-md-5">
          <!-- エラーメッセージ表示 -->
          <% if flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-circle me-2"></i>
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <% if flash[:notice] %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle me-2"></i>
              <%= flash[:notice] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <% if @reservation && @reservation.errors.any? && @reservation.errors.size > 0 %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <h6><i class="fas fa-exclamation-triangle me-2"></i>入力内容にエラーがあります / There are errors in your input</h6>
              <ul class="mb-0">
                <% @reservation.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <%= form_with model: @reservation, url: public_bookings_path, 
                        local: true, html: { id: 'booking-form' } do |f| %>
            
            <!-- Step 1: メニュー選択 -->
            <div class="step-section mb-4 mb-md-5">
              <h4 class="step-title">
                <span class="step-number">1</span>メニューを選択 / Select Menu
              </h4>
              
              <div class="row">
                <% @courses.each_with_index do |course, index| %>
                  <div class="col-md-6 mb-3 d-flex">
                    <div class="course-card" data-course="<%= course[:name] %>" data-duration="<%= course[:duration] %>">
                      <input type="radio" name="booking[course]" 
                             value="<%= course[:name] %>" 
                             id="course_<%= index %>"
                             data-duration="<%= course[:duration] %>"
                             <%= 'checked' if index == 0 %> hidden>
                      <div class="card h-100 course-option">
                        <div class="card-body text-center">
                          <h5 class="card-title">
                            <% if course[:name] == '対面セッション（スタジオ／出張）' %>
                              対面セッション<br>
                              <small style="font-size: 0.7em; color: #666; font-weight: normal;">In-Person Session</small>
                            <% elsif course[:name] == 'オンライン身体分析・設計' %>
                              オンライン身体分析<br>
                              <small style="font-size: 0.7em; color: #666; font-weight: normal;">Online Body Analysis</small>
                            <% else %>
                              <%= course[:name] %>
                            <% end %>
                          </h5>
                          <p class="price-display">
                            <% if course[:name] == 'オンライン身体分析・設計' %>
                              <span class="price-main">¥<%= number_with_delimiter(course[:price]) %>（テスト導入）</span>
                              <br class="price-break">
                              <small class="price-sub" style="font-size: 0.6em; color: #666;">¥<%= number_with_delimiter(course[:price]) %> (Test Price)</small>
                            <% else %>
                            ¥<%= number_with_delimiter(course[:price]) %>
                            <% end %>
                          </p>
                          <small class="text-muted">目安：約<%= course[:duration] %>分 / Approx. <%= course[:duration] %> minutes</small>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Step 2: 希望日時選択 - TimeRex風カレンダー -->
            <div class="step-section mb-4 mb-md-5">
              <h4 class="step-title">
                <span class="step-number">2</span>日時を選択 / Select Date & Time
              </h4>
              
              <!-- 週間カレンダー -->
              <div class="timerex-calendar-container">
                <div class="calendar-header">
                  <button type="button" class="btn-calendar-nav" id="prev-week">
                    <i class="fas fa-chevron-left"></i>
                  </button>
                  <div class="calendar-title" id="calendar-title">
                    <span id="week-range"></span>
                  </div>
                  <button type="button" class="btn-calendar-nav" id="next-week">
                    <i class="fas fa-chevron-right"></i>
                  </button>
                </div>
                
                <div class="calendar-week" id="calendar-week">
                  <!-- 週間カレンダーがここに動的に生成されます -->
                  <div class="loading-calendar">
                    <i class="fas fa-spinner fa-spin"></i> カレンダーを読み込み中... / Loading calendar...
                  </div>
                </div>
              </div>
              
              <!-- 選択された日時表示 -->
              <div id="selected-time-display" class="selected-time-display" style="display: none;">
                <div class="alert alert-info mb-0">
                  <i class="fas fa-check-circle me-2"></i>
                  <strong>選択された日時 / Selected Date & Time:</strong>
                  <span id="selected-date-time"></span>
              </div>
              </div>
              
              <!-- 隠しフィールド -->
              <input type="hidden" name="booking[selected_datetime]" id="selected-datetime">
            </div>
            
            <!-- Step 3: お客様情報 -->
            <div class="step-section mb-4">
              <h4 class="step-title">
                <span class="step-number">3</span>お客様情報 / Customer Information
              </h4>
              
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= label_tag 'booking[name]', 'お名前 / Name', class: 'form-label required' %>
                  <%= text_field_tag 'booking[name]', (@user_info&.dig(:name) || ''), 
                        { class: 'form-control', required: true, placeholder: '山田太郎 / Yamada Taro' } %>
                </div>
                
                <div class="col-md-6 mb-3">
                  <%= label_tag 'booking[phone_number]', 'お電話番号 / Phone Number', class: 'form-label required' %>
                  <%= telephone_field_tag 'booking[phone_number]', (@user_info&.dig(:phone_number) || ''), 
                        { class: 'form-control', required: true, placeholder: '090-1234-5678' } %>
                </div>
              </div>
              
              <div class="mb-3">
                <%= label_tag 'booking[email]', 'メールアドレス / Email', class: 'form-label' %>
                <%= email_field_tag 'booking[email]', (@user_info&.dig(:email) || ''), 
                      { class: 'form-control', placeholder: 'example@email.com' } %>
                <div class="form-text">ご連絡用（任意） / For contact (Optional)</div>
              </div>
              
              <div class="mb-3" id="address-field-container">
                <%= label_tag 'booking[address]', 'ご住所 / Address', class: 'form-label required', id: 'address-label' %>
                <%= text_area_tag 'booking[address]', (@user_info&.dig(:address) || ''), 
                      { class: 'form-control', rows: 2, id: 'address-field',
                        placeholder: '港区南麻布○-○-○　○○マンション○○号室 / Minato-ku Minami-Azabu ○-○-○ ○○ Mansion ○○' } %>
                <div class="form-text" id="address-help-text" style="display: none;">オンラインメニューの場合は任意です / Optional for online menu</div>
              </div>
              
              <div class="mb-3">
                <%= label_tag 'booking[access_notes]', 'アクセス・入館方法 / Access & Entry Method', class: 'form-label' %>
                <%= text_area_tag 'booking[access_notes]', '', 
                      { class: 'form-control', rows: 2,
                        placeholder: '最寄り駅、目印となる建物など / Nearest station, landmark buildings, etc.' } %>
              </div>
            </div>
            
            <!-- Step 4: ご要望・その他 -->
            <div class="step-section mb-4">
              <h4 class="step-title">
                <span class="step-number">4</span>ご要望・その他 / Requests & Other
              </h4>
              
              <div class="mb-3">
                <%= label_tag 'booking[notes]', 'ご要望・気になる箇所など / Requests & Concerns', class: 'form-label' %>
                <%= text_area_tag 'booking[notes]', '', 
                      { class: 'form-control', rows: 3,
                        placeholder: '肩こりがひどい、腰痛が気になる、初回で不安など / Severe shoulder stiffness, lower back pain concerns, first-time anxiety, etc.' } %>
              </div>
            </div>
            
            <!-- 確認事項 -->
            <div class="alert alert-warning">
              <h6><i class="fas fa-exclamation-triangle me-2"></i>ご確認ください / Please Confirm</h6>
              <ul class="mb-0">
                <li>選択された時間で<strong>仮予約</strong>いたします / A <strong>tentative reservation</strong> will be made for the selected time</li>
                <li>確認のご連絡後、正式な予約確定となります / The reservation will be confirmed after we contact you</li>
                <li>キャンセルは前日までにご連絡ください / Please contact us by the day before to cancel</li>
              </ul>
            </div>
            
            <!-- 送信ボタン -->
            <div class="text-center mt-4">
              <button type="submit" class="btn btn-primary btn-lg px-5" id="submit-btn" disabled>
                <i class="fas fa-paper-plane me-2"></i>
                予約リクエストを送信 / Submit Reservation Request
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for TimeRex風カレンダー -->
<script>
function initializeBookingPage() {
  // 予約フォームページかどうかをチェック
  const bookingForm = document.getElementById('booking-form');
  if (!bookingForm) {
    // 予約フォームページではない場合は初期化をスキップ
    return;
  }
  
  const courseCards = document.querySelectorAll('.course-card');
  const submitBtn = document.getElementById('submit-btn');
  let currentWeekStart = new Date();
  // 週の開始日を月曜日に設定
  const day = currentWeekStart.getDay();
  const diff = currentWeekStart.getDate() - day + (day === 0 ? -6 : 1); // 月曜日を週の開始に
  currentWeekStart.setDate(diff);
  currentWeekStart.setHours(0, 0, 0, 0);
  let selectedCourse = null;
  let selectedSlot = null;
  
  // メニュー選択処理
  courseCards.forEach(card => {
    card.addEventListener('click', function() {
      // 他のカードの選択解除
      courseCards.forEach(c => {
        c.querySelector('input').checked = false;
        c.querySelector('.card').classList.remove('selected');
      });
      
      // このカードを選択
      const radio = this.querySelector('input');
      radio.checked = true;
      this.querySelector('.card').classList.add('selected');
      selectedCourse = {
        name: radio.value,
        duration: parseInt(radio.dataset.duration)
      };
      
      // カレンダーを更新
      loadWeekCalendar();
      
      // 住所フィールドの必須/任意を切り替え
      updateAddressFieldRequirement();
    });
  });
  
  // 住所フィールドの必須/任意を切り替える関数
  function updateAddressFieldRequirement() {
    const addressField = document.getElementById('address-field');
    const addressLabel = document.getElementById('address-label');
    const addressHelpText = document.getElementById('address-help-text');
    const selectedCourse = document.querySelector('input[name="booking[course]"]:checked');
    
    if (!addressField || !addressLabel || !selectedCourse) return;
    
    const courseName = selectedCourse.value;
    const isOnline = courseName === 'オンライン身体分析・設計';
    
    if (isOnline) {
      // オンラインコースの場合：任意
      addressField.removeAttribute('required');
      addressLabel.classList.remove('required');
      addressHelpText.style.display = 'block';
    } else {
      // 対面セッションの場合：必須
      addressField.setAttribute('required', 'required');
      addressLabel.classList.add('required');
      addressHelpText.style.display = 'none';
    }
    
    // バリデーションを再実行
    validateForm();
  }
  
  // 初期選択状態の設定
  const checkedCourse = document.querySelector('input[name="booking[course]"]:checked');
  if (checkedCourse) {
    checkedCourse.closest('.course-card').querySelector('.card').classList.add('selected');
    selectedCourse = {
      name: checkedCourse.value,
      duration: parseInt(checkedCourse.dataset.duration)
    };
    loadWeekCalendar();
    // 住所フィールドの必須/任意を設定
    updateAddressFieldRequirement();
  }
  
  // 週間カレンダーの読み込み
  function loadWeekCalendar() {
    if (!selectedCourse) {
      document.getElementById('calendar-week').innerHTML = 
        '<div class="no-course-selected">まずメニューを選択してください / Please select a menu first</div>';
      return;
    }
    
    const weekStartStr = currentWeekStart.toISOString().split('T')[0];
    const calendarWeek = document.getElementById('calendar-week');
    calendarWeek.innerHTML = '<div class="loading-calendar"><i class="fas fa-spinner fa-spin"></i> カレンダーを読み込み中... / Loading calendar...</div>';
    
    console.log('📅 Loading calendar for week:', weekStartStr, 'duration:', selectedCourse.duration);
    
    fetch(`/public/bookings/week_calendar?start_date=${weekStartStr}&duration=${selectedCourse.duration}`)
      .then(response => {
        console.log('📅 Calendar API response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('📅 Calendar API data:', data);
        if (data.success) {
          renderWeekCalendar(data);
          updateWeekRange(data.week_start);
        } else {
          console.error('❌ Calendar API error:', data.error);
          calendarWeek.innerHTML = `<div class="error-message">エラーが発生しました / An error occurred: ${data.error || '不明なエラー / Unknown error'}</div>`;
        }
      })
      .catch(error => {
        console.error('❌ Error loading calendar:', error);
        calendarWeek.innerHTML = `<div class="error-message">通信エラーが発生しました / Communication error occurred: ${error.message}</div>`;
      });
  }
  
  // 週間カレンダーの描画（TimeRex風：時間軸縦表示）
  function renderWeekCalendar(data) {
    const calendarWeek = document.getElementById('calendar-week');
    const dayNames = ['日', '月', '火', '水', '木', '金', '土']; // JavaScriptのgetDay()は0=日曜日から
    
    // 営業時間の設定を取得（表示時間は10:00から20:30まで）
    const settings = data.settings || { business_hours_start: 10, business_hours_end: 21 };
    const startHour = 10; // 表示開始時間を10時に固定
    const endHour = 20; // 表示終了時間を20:30に固定
    
    // 時間帯を30分間隔で生成（10:00から20:30まで）
    const timeSlots = [];
    for (let hour = startHour; hour <= endHour; hour++) {
      timeSlots.push({ hour, minute: 0 });
      if (hour < endHour) { // 最後の時間（20:00）の場合は30分のスロット（20:30）を追加
        timeSlots.push({ hour, minute: 30 });
          } else {
        // 20:00の場合は20:30も追加
        timeSlots.push({ hour, minute: 30 });
      }
    }
    
    let html = '<div class="timerex-calendar-grid">';
    
    // 左上角の空白セル
    html += '<div class="time-label-header"></div>';
    
    // 日付ヘッダー行
    for (let i = 0; i < 7; i++) {
      const date = new Date(data.week_start);
      date.setDate(date.getDate() + i);
      const dateStr = date.toISOString().split('T')[0];
      const dayData = data.week_data[dateStr];
      
      // 実際の日付の曜日を取得
      const dayOfWeek = date.getDay(); // 0=日曜日, 1=月曜日, ..., 6=土曜日
      const dayName = dayNames[dayOfWeek];
      
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const checkDate = new Date(date);
      checkDate.setHours(0, 0, 0, 0);
      const isToday = checkDate.getTime() === today.getTime();
      
      html += `
        <div class="day-header-cell ${isToday ? 'today' : ''} ${!dayData ? 'disabled' : ''}">
          <div class="day-name">${dayName}</div>
          <div class="day-number">${dayData ? dayData.day_number : date.getDate()}</div>
          ${isToday ? '<div class="today-badge">今日</div>' : ''}
        </div>
      `;
    }
    
    // 右上角の空白セル
    html += '<div class="time-label-header"></div>';
    
    // 各日のスロット情報を整理（開始時間をキーに）
    const daySlotsMap = {};
    for (let i = 0; i < 7; i++) {
      const date = new Date(data.week_start);
      date.setDate(date.getDate() + i);
      const dateStr = date.toISOString().split('T')[0];
      const dayData = data.week_data[dateStr];
      
      if (dayData) {
        daySlotsMap[dateStr] = {};
        dayData.slots.forEach(slot => {
          const slotTime = new Date(slot.start_datetime);
          const key = `${slotTime.getHours()}:${slotTime.getMinutes()}`;
          daySlotsMap[dateStr][key] = slot;
        });
      }
    }
    
    // 各日のスロットがどの行に表示されるかを追跡
    const slotRowMap = {};
    
    // 時間行を生成
    timeSlots.forEach((timeSlot, timeIndex) => {
      const timeStr = `${String(timeSlot.hour).padStart(2, '0')}:${String(timeSlot.minute).padStart(2, '0')}`;
      const timeKey = `${timeSlot.hour}:${timeSlot.minute}`;
      const rowNumber = timeIndex + 2; // ヘッダー行が1行目なので+2
      
      // 時間ラベル（左側）- 列1
      html += `<div class="time-label" style="grid-row: ${rowNumber}; grid-column: 1;">${timeStr}</div>`;
      
      // 各日の時間セル - 列2-8
      for (let i = 0; i < 7; i++) {
        const colNumber = i + 2; // 列2から開始
        const date = new Date(data.week_start);
        date.setDate(date.getDate() + i);
        const dateStr = date.toISOString().split('T')[0];
        const dayData = data.week_data[dateStr];
        
        if (!dayData) {
          html += `<div class="time-cell disabled" style="grid-row: ${rowNumber}; grid-column: ${colNumber};"></div>`;
          continue;
        }
        
        // この時間帯に開始するスロットを探す
        const matchingSlot = daySlotsMap[dateStr] && daySlotsMap[dateStr][timeKey];
        
        if (matchingSlot) {
          const slotTime = new Date(matchingSlot.start_datetime);
          const slotEndTime = new Date(matchingSlot.end_datetime);
          const durationMinutes = (slotEndTime - slotTime) / (1000 * 60);
          const rowSpan = Math.max(1, Math.round(durationMinutes / 30));
          
          const startTimeStr = slotTime.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
          const endTimeStr = slotEndTime.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
          
          // スロットがこの行で開始する場合のみ表示
          if (slotTime.getHours() === timeSlot.hour && slotTime.getMinutes() === timeSlot.minute) {
            // このスロットがどの行に表示されるかを記録
            const slotKey = `${dateStr}_${timeKey}`;
            slotRowMap[slotKey] = { startRow: rowNumber, rowSpan: rowSpan };
            
            // スロットの高さに応じて表示を調整（実際の時間に基づく）
            let slotClass = '';
            if (durationMinutes <= 30) {
              slotClass = 'very-short-slot';
            } else if (durationMinutes <= 60) {
              slotClass = 'short-slot';
            } else if (durationMinutes <= 90) {
              slotClass = 'medium-slot';
        } else {
              slotClass = 'long-slot';
            }
            
            // 常に縦配置で表示（見やすさのため）
            const timeDisplay = `<div class="time-start">${startTimeStr}</div><div class="time-separator">-</div><div class="time-end">${endTimeStr}</div>`;
            
            html += `
              <div class="time-cell available ${slotClass}" 
                   data-datetime="${matchingSlot.start_datetime}"
                   data-date="${dateStr}"
                   data-time="${timeStr}"
                   data-duration="${durationMinutes}"
                   style="grid-row: ${rowNumber} / span ${rowSpan}; grid-column: ${colNumber};">
                <div class="time-slot-block">
                  ${timeDisplay}
                </div>
              </div>
            `;
          } else {
            // スロットがこの行に含まれるが開始しない場合は何も表示しない（スロットの継続部分）
            // グリッドレイアウトでは、スパンでカバーされるため表示不要
          }
        } else {
          // この行にスロットが含まれているかチェック
          let hasSlotInThisRow = false;
          if (dayData.slots) {
            for (const slot of dayData.slots) {
              const slotStart = new Date(slot.start_datetime);
              const slotEnd = new Date(slot.end_datetime);
              const currentTime = new Date(`${dateStr}T${timeStr}:00`);
              
              // この時間帯がスロットの範囲内にあるかチェック
              if (currentTime >= slotStart && currentTime < slotEnd) {
                // スロットの開始時間でない場合のみスロットの継続部分
                if (!(slotStart.getHours() === timeSlot.hour && slotStart.getMinutes() === timeSlot.minute)) {
                  hasSlotInThisRow = true;
                  break;
                }
              }
            }
          }
          
          if (!hasSlotInThisRow) {
            html += `<div class="time-cell empty" style="grid-row: ${rowNumber}; grid-column: ${colNumber};"></div>`;
          }
          // スロットの継続部分の場合は何も表示しない（スパンでカバーされるため）
        }
      }
      
      // 時間ラベル（右側）- 列9
      html += `<div class="time-label" style="grid-row: ${rowNumber}; grid-column: 9;">${timeStr}</div>`;
    });
    
    html += '</div>';
    
    calendarWeek.innerHTML = html;
    
    // 時間スロットのクリックイベント
    document.querySelectorAll('.time-cell.available').forEach(cell => {
      cell.addEventListener('click', function() {
        // 他のセルの選択解除
        document.querySelectorAll('.time-cell').forEach(c => c.classList.remove('selected'));
        
        // このセルを選択
        this.classList.add('selected');
        selectedSlot = {
          datetime: this.dataset.datetime,
          display: this.querySelector('.time-slot-block').textContent.trim()
        };
        
        // フォームに値を設定
        const datetimeField = document.getElementById('selected-datetime');
        if (datetimeField) {
          datetimeField.value = selectedSlot.datetime;
          console.log('✅ Selected datetime set:', selectedSlot.datetime);
        }
        
        // 選択された日時を表示
        const date = new Date(selectedSlot.datetime);
        const dateStrJP = `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${date.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' })}`;
        const dateStrEN = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' ' + date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('selected-date-time').textContent = dateStrJP + ' / ' + dateStrEN;
        document.getElementById('selected-time-display').style.display = 'block';
        
        validateForm();
      });
    });
  }
  
  // 週の範囲を更新
  function updateWeekRange(weekStartStr) {
    const start = new Date(weekStartStr);
    const end = new Date(start);
    end.setDate(end.getDate() + 6);
    
    const startMonth = start.getMonth() + 1;
    const startDate = start.getDate();
    const endMonth = end.getMonth() + 1;
    const endDate = end.getDate();
    
    let startStr = `${startMonth}月${startDate}日`;
    let endStr = `${endMonth}月${endDate}日`;
    
    if (startMonth === endMonth) {
      document.getElementById('week-range').textContent = `${startMonth}月${startDate}日 - ${endDate}日`;
    } else {
      document.getElementById('week-range').textContent = `${startStr} - ${endStr}`;
    }
  }
  
  // 選択をクリアする関数
  function clearTimeSelection() {
    selectedSlot = null;
    const datetimeField = document.getElementById('selected-datetime');
    if (datetimeField) {
      datetimeField.value = '';
    }
    const selectedTimeDisplay = document.getElementById('selected-time-display');
    if (selectedTimeDisplay) {
      selectedTimeDisplay.style.display = 'none';
    }
    // 選択されたスロットのハイライトを解除
    document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
  }
  
  // 前の週へ
  const prevWeekBtn = document.getElementById('prev-week');
  if (prevWeekBtn) {
    prevWeekBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      clearTimeSelection();
      currentWeekStart.setDate(currentWeekStart.getDate() - 7);
      loadWeekCalendar();
      validateForm();
    });
  }
  
  // 次の週へ
  const nextWeekBtn = document.getElementById('next-week');
  if (nextWeekBtn) {
    nextWeekBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      clearTimeSelection();
      currentWeekStart.setDate(currentWeekStart.getDate() + 7);
      loadWeekCalendar();
        validateForm();
      });
  }
  
  // フォームバリデーション
  function validateForm() {
    const datetimeField = document.getElementById('selected-datetime');
    const selectedCourse = document.querySelector('input[name="booking[course]"]:checked');
    const nameField = document.querySelector('input[name="booking[name]"]');
    const phoneField = document.querySelector('input[name="booking[phone_number]"]');
    const addressField = document.querySelector('textarea[name="booking[address]"]');
    
    let allValid = true;
    
    // 必須項目のチェック
    if (!selectedCourse) {
        allValid = false;
      }
    
    if (!datetimeField || !datetimeField.value) {
      allValid = false;
    }
    
    if (!nameField || !nameField.value.trim()) {
      allValid = false;
    }
    
    if (!phoneField || !phoneField.value.trim()) {
      allValid = false;
    }
    
    // 住所フィールドのバリデーション（オンラインメニューの場合は任意）
    const courseName = selectedCourse?.value || '';
    const isOnline = courseName === 'オンライン身体分析・設計';
    if (!isOnline && (!addressField || !addressField.value.trim())) {
        allValid = false;
      }
    
    submitBtn.disabled = !allValid;
  }
  
  // 入力項目の変更監視
  if (bookingForm) {
    bookingForm.addEventListener('input', validateForm);
    bookingForm.addEventListener('change', validateForm);
    
    // フォーム送信前の確認
    bookingForm.addEventListener('submit', function(e) {
    const datetimeField = document.getElementById('selected-datetime');
    const selectedCourse = document.querySelector('input[name="booking[course]"]:checked');
    
    console.log('📝 Form submit - datetime:', datetimeField?.value);
    console.log('📝 Form submit - course:', selectedCourse?.value);
    
    if (!selectedCourse) {
      e.preventDefault();
      alert('メニューを選択してください。\nPlease select a menu.');
      return false;
    }
    
    if (!datetimeField || !datetimeField.value) {
      e.preventDefault();
      alert('予約日時を選択してください。カレンダーから日時を選択してください。\nPlease select a date and time. Select a date and time from the calendar.');
      return false;
    }
    
    return true;
    });
  }
}

// DOMContentLoadedとturbo:loadの両方で初期化
document.addEventListener('DOMContentLoaded', initializeBookingPage);
document.addEventListener('turbo:load', initializeBookingPage);
// Turbo 7ではturbo:loadが使えない場合があるので、turbo:frame-loadも追加
document.addEventListener('turbo:frame-load', initializeBookingPage);
</script>

