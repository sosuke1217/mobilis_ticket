<!-- app/views/public/bookings/new.html.erb -->
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card shadow-lg timerex-style">
        <div class="card-header timerex-header text-center">
          <h2 class="mb-0">
            <i class="fas fa-calendar-check me-2"></i>
            出張ストレッチ予約
          </h2>
          <p class="mb-0 mt-2">広尾エリア専門</p>
        </div>
        
        <div class="card-body p-4">
          <!-- エラーメッセージ表示 -->
          <% if flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-circle me-2"></i>
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <% if flash[:notice] %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle me-2"></i>
              <%= flash[:notice] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <% if @reservation && @reservation.errors.any? && @reservation.errors.size > 0 %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <h6><i class="fas fa-exclamation-triangle me-2"></i>入力内容にエラーがあります</h6>
              <ul class="mb-0">
                <% @reservation.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>
          
          <%= form_with model: @reservation, url: public_bookings_path, 
                        local: true, html: { id: 'booking-form' } do |f| %>
            
            <!-- Step 1: コース選択 -->
            <div class="step-section mb-5">
              <h4 class="step-title">
                <span class="step-number">1</span>コースを選択
              </h4>
              
              <div class="row">
                <% @courses.each_with_index do |course, index| %>
                  <div class="col-md-4 mb-3">
                    <div class="course-card" data-course="<%= course[:name] %>" data-duration="<%= course[:duration] %>">
                      <input type="radio" name="booking[course]" 
                             value="<%= course[:name] %>" 
                             id="course_<%= index %>"
                             data-duration="<%= course[:duration] %>"
                             <%= 'checked' if index == 1 %> hidden>
                      <div class="card h-100 course-option">
                        <div class="card-body text-center">
                          <h5 class="card-title"><%= course[:name] %></h5>
                          <p class="price-display">
                            ¥<%= number_with_delimiter(course[:price]) %>
                          </p>
                          <small class="text-muted"><%= course[:duration] %>分</small>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Step 2: 希望日時選択 - TimeRex風カレンダー -->
            <div class="step-section mb-5">
              <h4 class="step-title">
                <span class="step-number">2</span>日時を選択
              </h4>
              
              <!-- 週間カレンダー -->
              <div class="timerex-calendar-container">
                <div class="calendar-header">
                  <button type="button" class="btn-calendar-nav" id="prev-week">
                    <i class="fas fa-chevron-left"></i>
                  </button>
                  <div class="calendar-title" id="calendar-title">
                    <span id="week-range"></span>
                  </div>
                  <button type="button" class="btn-calendar-nav" id="next-week">
                    <i class="fas fa-chevron-right"></i>
                  </button>
                </div>
                
                <div class="calendar-week" id="calendar-week">
                  <!-- 週間カレンダーがここに動的に生成されます -->
                  <div class="loading-calendar">
                    <i class="fas fa-spinner fa-spin"></i> カレンダーを読み込み中...
                  </div>
                </div>
              </div>
              
              <!-- 選択された日時表示 -->
              <div id="selected-time-display" class="selected-time-display" style="display: none;">
                <div class="alert alert-info mb-0">
                  <i class="fas fa-check-circle me-2"></i>
                  <strong>選択された日時:</strong>
                  <span id="selected-date-time"></span>
                </div>
              </div>
              
              <!-- 隠しフィールド -->
              <input type="hidden" name="booking[selected_datetime]" id="selected-datetime">
            </div>
            
            <!-- Step 3: お客様情報 -->
            <div class="step-section mb-4">
              <h4 class="step-title">
                <span class="step-number">3</span>お客様情報
              </h4>
              
              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= label_tag 'booking[name]', 'お名前', class: 'form-label required' %>
                  <%= text_field_tag 'booking[name]', (@user_info&.dig(:name) || ''), 
                        { class: 'form-control', required: true, placeholder: '山田太郎' } %>
                </div>
                
                <div class="col-md-6 mb-3">
                  <%= label_tag 'booking[phone_number]', 'お電話番号', class: 'form-label required' %>
                  <%= telephone_field_tag 'booking[phone_number]', (@user_info&.dig(:phone_number) || ''), 
                        { class: 'form-control', required: true, placeholder: '090-1234-5678' } %>
                </div>
              </div>
              
              <div class="mb-3">
                <%= label_tag 'booking[email]', 'メールアドレス', class: 'form-label' %>
                <%= email_field_tag 'booking[email]', (@user_info&.dig(:email) || ''), 
                      { class: 'form-control', placeholder: 'example@email.com' } %>
                <div class="form-text">ご連絡用（任意）</div>
              </div>
              
              <div class="mb-3">
                <%= label_tag 'booking[address]', 'ご住所', class: 'form-label required' %>
                <%= text_area_tag 'booking[address]', (@user_info&.dig(:address) || ''), 
                      { class: 'form-control', rows: 2, required: true,
                        placeholder: '港区南麻布○-○-○　○○マンション○○号室' } %>
              </div>
              
              <div class="mb-3">
                <%= label_tag 'booking[access_notes]', 'アクセス・入館方法', class: 'form-label' %>
                <%= text_area_tag 'booking[access_notes]', '', 
                      { class: 'form-control', rows: 2,
                        placeholder: 'オートロック番号、最寄り駅、目印となる建物など' } %>
              </div>
            </div>
            
            <!-- Step 4: ご要望・その他 -->
            <div class="step-section mb-4">
              <h4 class="step-title">
                <span class="step-number">4</span>ご要望・その他
              </h4>
              
              <div class="mb-3">
                <%= label_tag 'booking[notes]', 'ご要望・気になる箇所など', class: 'form-label' %>
                <%= text_area_tag 'booking[notes]', '', 
                      { class: 'form-control', rows: 3,
                        placeholder: '肩こりがひどい、腰痛が気になる、初回で不安など' } %>
              </div>
            </div>
            
            <!-- 確認事項 -->
            <div class="alert alert-warning">
              <h6><i class="fas fa-exclamation-triangle me-2"></i>ご確認ください</h6>
              <ul class="mb-0">
                <li>選択された時間で<strong>仮予約</strong>いたします</li>
                <li>確認のご連絡後、正式な予約確定となります</li>
                <li>キャンセルは前日までにご連絡ください</li>
                <li>出張費は料金に含まれています</li>
              </ul>
            </div>
            
            <!-- 送信ボタン -->
            <div class="text-center mt-4">
              <button type="submit" class="btn btn-primary btn-lg px-5" id="submit-btn" disabled>
                <i class="fas fa-paper-plane me-2"></i>
                予約リクエストを送信
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for TimeRex風カレンダー -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const courseCards = document.querySelectorAll('.course-card');
  const submitBtn = document.getElementById('submit-btn');
  let currentWeekStart = new Date();
  // 週の開始日を月曜日に設定
  const day = currentWeekStart.getDay();
  const diff = currentWeekStart.getDate() - day + (day === 0 ? -6 : 1); // 月曜日を週の開始に
  currentWeekStart.setDate(diff);
  currentWeekStart.setHours(0, 0, 0, 0);
  let selectedCourse = null;
  let selectedSlot = null;
  
  // コース選択処理
  courseCards.forEach(card => {
    card.addEventListener('click', function() {
      // 他のカードの選択解除
      courseCards.forEach(c => {
        c.querySelector('input').checked = false;
        c.querySelector('.card').classList.remove('selected');
      });
      
      // このカードを選択
      const radio = this.querySelector('input');
      radio.checked = true;
      this.querySelector('.card').classList.add('selected');
      selectedCourse = {
        name: radio.value,
        duration: parseInt(radio.dataset.duration)
      };
      
      // カレンダーを更新
      loadWeekCalendar();
    });
  });
  
  // 初期選択状態の設定
  const checkedCourse = document.querySelector('input[name="booking[course]"]:checked');
  if (checkedCourse) {
    checkedCourse.closest('.course-card').querySelector('.card').classList.add('selected');
    selectedCourse = {
      name: checkedCourse.value,
      duration: parseInt(checkedCourse.dataset.duration)
    };
    loadWeekCalendar();
  }
  
  // 週間カレンダーの読み込み
  function loadWeekCalendar() {
    if (!selectedCourse) {
      document.getElementById('calendar-week').innerHTML = 
        '<div class="no-course-selected">まずコースを選択してください</div>';
      return;
    }
    
    const weekStartStr = currentWeekStart.toISOString().split('T')[0];
    const calendarWeek = document.getElementById('calendar-week');
    calendarWeek.innerHTML = '<div class="loading-calendar"><i class="fas fa-spinner fa-spin"></i> カレンダーを読み込み中...</div>';
    
    console.log('📅 Loading calendar for week:', weekStartStr, 'duration:', selectedCourse.duration);
    
    fetch(`/public/bookings/week_calendar?start_date=${weekStartStr}&duration=${selectedCourse.duration}`)
      .then(response => {
        console.log('📅 Calendar API response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(data => {
        console.log('📅 Calendar API data:', data);
        if (data.success) {
          renderWeekCalendar(data);
          updateWeekRange(data.week_start);
        } else {
          console.error('❌ Calendar API error:', data.error);
          calendarWeek.innerHTML = `<div class="error-message">エラーが発生しました: ${data.error || '不明なエラー'}</div>`;
        }
      })
      .catch(error => {
        console.error('❌ Error loading calendar:', error);
        calendarWeek.innerHTML = `<div class="error-message">通信エラーが発生しました: ${error.message}</div>`;
      });
  }
  
  // 週間カレンダーの描画（TimeRex風：時間軸縦表示）
  function renderWeekCalendar(data) {
    const calendarWeek = document.getElementById('calendar-week');
    const days = ['月', '火', '水', '木', '金', '土', '日'];
    
    // 営業時間の設定を取得
    const settings = data.settings || { business_hours_start: 10, business_hours_end: 19 };
    const startHour = settings.business_hours_start || 10;
    const endHour = settings.business_hours_end || 19;
    
    // 時間帯を30分間隔で生成
    const timeSlots = [];
    for (let hour = startHour; hour < endHour; hour++) {
      timeSlots.push({ hour, minute: 0 });
      timeSlots.push({ hour, minute: 30 });
    }
    
    let html = '<div class="timerex-calendar-grid">';
    
    // 左上角の空白セル
    html += '<div class="time-label-header"></div>';
    
    // 日付ヘッダー行
    for (let i = 0; i < 7; i++) {
      const date = new Date(data.week_start);
      date.setDate(date.getDate() + i);
      const dateStr = date.toISOString().split('T')[0];
      const dayData = data.week_data[dateStr];
      
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const checkDate = new Date(date);
      checkDate.setHours(0, 0, 0, 0);
      const isToday = checkDate.getTime() === today.getTime();
      
      html += `
        <div class="day-header-cell ${isToday ? 'today' : ''} ${!dayData ? 'disabled' : ''}">
          <div class="day-name">${days[i]}</div>
          <div class="day-number">${dayData ? dayData.day_number : date.getDate()}</div>
          ${isToday ? '<div class="today-badge">今日</div>' : ''}
        </div>
      `;
    }
    
    // 各日のスロット情報を整理（開始時間をキーに）
    const daySlotsMap = {};
    for (let i = 0; i < 7; i++) {
      const date = new Date(data.week_start);
      date.setDate(date.getDate() + i);
      const dateStr = date.toISOString().split('T')[0];
      const dayData = data.week_data[dateStr];
      
      if (dayData) {
        daySlotsMap[dateStr] = {};
        dayData.slots.forEach(slot => {
          const slotTime = new Date(slot.start_datetime);
          const key = `${slotTime.getHours()}:${slotTime.getMinutes()}`;
          daySlotsMap[dateStr][key] = slot;
        });
      }
    }
    
    // 時間行を生成
    timeSlots.forEach((timeSlot, timeIndex) => {
      const timeStr = `${String(timeSlot.hour).padStart(2, '0')}:${String(timeSlot.minute).padStart(2, '0')}`;
      const timeKey = `${timeSlot.hour}:${timeSlot.minute}`;
      
      // 時間ラベル（左側）
      html += `<div class="time-label">${timeStr}</div>`;
      
      // 各日の時間セル
      for (let i = 0; i < 7; i++) {
        const date = new Date(data.week_start);
        date.setDate(date.getDate() + i);
        const dateStr = date.toISOString().split('T')[0];
        const dayData = data.week_data[dateStr];
        
        if (!dayData) {
          html += '<div class="time-cell disabled"></div>';
          continue;
        }
        
        // この時間帯に開始するスロットを探す
        const matchingSlot = daySlotsMap[dateStr] && daySlotsMap[dateStr][timeKey];
        
        if (matchingSlot) {
          const slotTime = new Date(matchingSlot.start_datetime);
          const slotEndTime = new Date(matchingSlot.end_datetime);
          const durationMinutes = (slotEndTime - slotTime) / (1000 * 60);
          const rowSpan = Math.max(1, Math.round(durationMinutes / 30));
          
          const startTimeStr = slotTime.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
          const endTimeStr = slotEndTime.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
          
          // スロットがこの行で開始する場合のみ表示
          if (slotTime.getHours() === timeSlot.hour && slotTime.getMinutes() === timeSlot.minute) {
            html += `
              <div class="time-cell available" 
                   data-datetime="${matchingSlot.start_datetime}"
                   data-date="${dateStr}"
                   data-time="${timeStr}"
                   style="grid-row: span ${rowSpan}">
                <div class="time-slot-block">
                  ${startTimeStr} - ${endTimeStr}
                </div>
              </div>
            `;
          } else {
            // スロットがこの行に含まれるが開始しない場合は空
            html += '<div class="time-cell empty"></div>';
          }
        } else {
          html += '<div class="time-cell empty"></div>';
        }
      }
      
      // 時間ラベル（右側）
      html += `<div class="time-label">${timeStr}</div>`;
    });
    
    html += '</div>';
    
    calendarWeek.innerHTML = html;
    
    // 時間スロットのクリックイベント
    document.querySelectorAll('.time-cell.available').forEach(cell => {
      cell.addEventListener('click', function() {
        // 他のセルの選択解除
        document.querySelectorAll('.time-cell').forEach(c => c.classList.remove('selected'));
        
        // このセルを選択
        this.classList.add('selected');
        selectedSlot = {
          datetime: this.dataset.datetime,
          display: this.querySelector('.time-slot-block').textContent.trim()
        };
        
        // フォームに値を設定
        const datetimeField = document.getElementById('selected-datetime');
        if (datetimeField) {
          datetimeField.value = selectedSlot.datetime;
          console.log('✅ Selected datetime set:', selectedSlot.datetime);
        }
        
        // 選択された日時を表示
        const date = new Date(selectedSlot.datetime);
        const dateStr = `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 ${date.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' })}`;
        document.getElementById('selected-date-time').textContent = dateStr;
        document.getElementById('selected-time-display').style.display = 'block';
        
        validateForm();
      });
    });
  }
  
  // 週の範囲を更新
  function updateWeekRange(weekStartStr) {
    const start = new Date(weekStartStr);
    const end = new Date(start);
    end.setDate(end.getDate() + 6);
    
    const startMonth = start.getMonth() + 1;
    const startDate = start.getDate();
    const endMonth = end.getMonth() + 1;
    const endDate = end.getDate();
    
    let startStr = `${startMonth}月${startDate}日`;
    let endStr = `${endMonth}月${endDate}日`;
    
    if (startMonth === endMonth) {
      document.getElementById('week-range').textContent = `${startMonth}月${startDate}日 - ${endDate}日`;
    } else {
      document.getElementById('week-range').textContent = `${startStr} - ${endStr}`;
    }
  }
  
  // 選択をクリアする関数
  function clearTimeSelection() {
    selectedSlot = null;
    const datetimeField = document.getElementById('selected-datetime');
    if (datetimeField) {
      datetimeField.value = '';
    }
    const selectedTimeDisplay = document.getElementById('selected-time-display');
    if (selectedTimeDisplay) {
      selectedTimeDisplay.style.display = 'none';
    }
    // 選択されたスロットのハイライトを解除
    document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
  }
  
  // 前の週へ
  document.getElementById('prev-week').addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    clearTimeSelection();
    currentWeekStart.setDate(currentWeekStart.getDate() - 7);
    loadWeekCalendar();
    validateForm();
  });
  
  // 次の週へ
  document.getElementById('next-week').addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    clearTimeSelection();
    currentWeekStart.setDate(currentWeekStart.getDate() + 7);
    loadWeekCalendar();
    validateForm();
  });
  
  // フォームバリデーション
  function validateForm() {
    const datetimeField = document.getElementById('selected-datetime');
    const selectedCourse = document.querySelector('input[name="booking[course]"]:checked');
    const nameField = document.querySelector('input[name="booking[name]"]');
    const phoneField = document.querySelector('input[name="booking[phone_number]"]');
    const addressField = document.querySelector('textarea[name="booking[address]"]');
    
    let allValid = true;
    
    // 必須項目のチェック
    if (!selectedCourse) {
      allValid = false;
    }
    
    if (!datetimeField || !datetimeField.value) {
      allValid = false;
    }
    
    if (!nameField || !nameField.value.trim()) {
      allValid = false;
    }
    
    if (!phoneField || !phoneField.value.trim()) {
      allValid = false;
    }
    
    if (!addressField || !addressField.value.trim()) {
      allValid = false;
    }
    
    submitBtn.disabled = !allValid;
  }
  
  // 入力項目の変更監視
  document.getElementById('booking-form').addEventListener('input', validateForm);
  document.getElementById('booking-form').addEventListener('change', validateForm);
  
  // フォーム送信前の確認
  document.getElementById('booking-form').addEventListener('submit', function(e) {
    const datetimeField = document.getElementById('selected-datetime');
    const selectedCourse = document.querySelector('input[name="booking[course]"]:checked');
    
    console.log('📝 Form submit - datetime:', datetimeField?.value);
    console.log('📝 Form submit - course:', selectedCourse?.value);
    
    if (!selectedCourse) {
      e.preventDefault();
      alert('コースを選択してください。');
      return false;
    }
    
    if (!datetimeField || !datetimeField.value) {
      e.preventDefault();
      alert('予約日時を選択してください。カレンダーから日時を選択してください。');
      return false;
    }
    
    return true;
  });
});
</script>

<style>
/* TimeRex風スタイル */
.timerex-style {
  border-radius: 16px;
  overflow: hidden;
}

.timerex-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30px;
  border: none;
}

.timerex-header h2 {
  font-weight: 700;
  font-size: 2rem;
}

.step-section {
  border-left: 4px solid #667eea;
  padding-left: 24px;
  margin-bottom: 2.5rem;
}

.step-title {
  color: #667eea;
  margin-bottom: 1.5rem;
  font-weight: 600;
  font-size: 1.25rem;
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 50%;
  margin-right: 12px;
  font-weight: 700;
  font-size: 1.1rem;
}

.course-card {
  cursor: pointer;
  transition: all 0.3s ease;
}

.course-option {
  border: 2px solid #e0e0e0;
  border-radius: 12px;
  transition: all 0.3s ease;
  background: white;
}

.course-card:hover .course-option,
.course-card input:checked ~ .course-option,
.course-option.selected {
  border-color: #667eea;
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
  background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
}

.price-display {
  font-size: 1.75rem;
  color: #667eea;
  font-weight: 700;
  margin: 0.5rem 0;
}

/* TimeRex風カレンダー - 改善版 */
.timerex-calendar-container {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 8px 32px rgba(102, 126, 234, 0.12);
  margin-bottom: 24px;
  border: 1px solid rgba(102, 126, 234, 0.1);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 2px solid rgba(102, 126, 234, 0.1);
}

.btn-calendar-nav {
  background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
  border: 2px solid rgba(102, 126, 234, 0.2);
  border-radius: 12px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
