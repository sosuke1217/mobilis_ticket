<!DOCTYPE html>
<html>
<head>
  <title>管理画面</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag    "application", media: "all" %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <%= javascript_importmap_tags %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    .sidebar {
      min-height: 100vh;
      background-color: #f8f9fa;
      border-right: 1px solid #dee2e6;
    }
    .sidebar .nav-link {
      color: #495057;
      padding: 0.75rem 1rem;
      border-radius: 0.375rem;
      margin: 0.125rem 0;
    }
    .sidebar .nav-link:hover {
      background-color: #e9ecef;
      color: #212529;
    }
    .sidebar .nav-link.active {
      background-color: #0d6efd;
      color: white;
    }
    .sidebar .nav-link i {
      width: 1.25rem;
      margin-right: 0.5rem;
    }
    .main-content {
      padding: 2rem;
    }
    .header {
      background-color: white;
      border-bottom: 1px solid #dee2e6;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <!-- サイドバーナビゲーション -->
      <nav class="col-md-3 col-lg-2 d-md-block sidebar">
        <div class="position-sticky pt-3">
          <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
            <span>管理メニュー</span>
          </h6>
          <ul class="nav flex-column">
            <li class="nav-item">
              <%= link_to admin_dashboard_path, class: "nav-link #{current_page?(admin_dashboard_path) ? 'active' : ''}" do %>
                <i class="fas fa-tachometer-alt"></i>
                ダッシュボード
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_users_path, class: "nav-link #{controller_name == 'users' ? 'active' : ''}" do %>
                <i class="fas fa-users"></i>
                ユーザー管理
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_tickets_path, class: "nav-link #{controller_name == 'tickets' ? 'active' : ''}" do %>
                <i class="fas fa-ticket-alt"></i>
                チケット管理
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_ticket_templates_path, class: "nav-link #{controller_name == 'ticket_templates' ? 'active' : ''}" do %>
                <i class="fas fa-copy"></i>
                テンプレート管理
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_ticket_usages_path, class: "nav-link #{controller_name == 'ticket_usages' ? 'active' : ''}" do %>
                <i class="fas fa-history"></i>
                使用履歴管理
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_reservations_path, class: "nav-link #{controller_name == 'reservations' ? 'active' : ''}" do %>
                <i class="fas fa-calendar-alt"></i>
                予約管理
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_reservations_calendar_path, class: "nav-link #{action_name == 'calendar' ? 'active' : ''}" do %>
                <i class="fas fa-calendar-week"></i>
                予約カレンダー
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to admin_notification_logs_path, class: "nav-link #{controller_name == 'notification_logs' ? 'active' : ''}" do %>
                <i class="fas fa-bell"></i>
                通知ログ
              <% end %>
            </li>
          </ul>
        </div>
      </nav>

      <!-- メインコンテンツ -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <!-- ヘッダー -->
        <div class="header">
          <h1 class="h3 mb-0">管理ダッシュボード</h1>
          <button type="button" class="btn btn-outline-danger" onclick="logout()">
            <i class="fas fa-sign-out-alt"></i>
            ログアウト
          </button>
        </div>

        <!-- ページコンテンツ -->
        <%= yield %>
      </main>
    </div>
  </div>

  <script>
    function logout() {
      if (confirm('本当にログアウトしますか？')) {
        // CSRFトークンを取得
        const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        
        // フォームを作成して送信
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '<%= destroy_admin_user_session_path %>';
        form.style.display = 'none';
        
        // CSRFトークンを追加
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = token;
        form.appendChild(csrfInput);
        
        // methodをDELETEに設定
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'DELETE';
        form.appendChild(methodInput);
        
        // フォームを送信
        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>
</body>
</html>